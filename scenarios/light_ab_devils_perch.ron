// Lighting A/B (each view without and with the sky light and baked occlusion, _a/_b): Devil's Perch (night): the village centre, a house interior, a quad bike.
// Views with the sun (or moon) behind and in front of the camera, the sky, our soldier in
// third person lit from the side, a building interior and a vehicle close up.
// client --scenario scenarios/light_ab_devils_perch.ron --out target/scenarios/light/ab/devils_perch
(
    level: "devils_perch",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        // Sun behind the camera: sunlit faces.
        Teleport((-368.0, 14.0, 168.0), 34.0, -4.0),
        Wait(1.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("sunlit_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("sunlit_b"),
        // Facing the sun: shaded faces against the bright sky.
        Look(-146.0, -4.0),
        Wait(0.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("against_sun_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("against_sun_b"),
        Look(124.0, 18.0),
        Wait(0.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("sky_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("sky_b"),
        // Our soldier, lit from the side.
        ThirdPerson(true),
        Look(124.0, -8.0),
        Wait(2.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("soldier_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("soldier_b"),
        ThirdPerson(false),
        Teleport((-340.0, 13.2, 135.0), 0.0, -2.0),
        Wait(1.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("interior_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("interior_b"),
        NearVehicle("xpak_atv"),
        ThirdPerson(true),
        Wait(2.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("vehicle_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("vehicle_b"),
        // Frame times without and with the sky light and baked occlusion.
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(1.0),
        Measure("phase1", 5.0),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(1.0),
        Measure("phase2", 5.0),
        Quit,
    ],
)
