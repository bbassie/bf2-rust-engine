// Rendering cost and look of SSAO and sun shadows from one fixed spectator view.
// client --scenario scenarios/lighting/render_ab.ron   (report: target/scenarios/render_ab/report.txt)
(
    level: "strike_at_karkand",
    bots: 0,
    spectate: true,
    steps: [
        WaitReady,
        Camera((-184.0, 157.5, -80.0), 20.0, -8.0),
        Wait(1.0),
        Screenshot("ssao_on"),
        Measure("ssao on", 4.0),
        Ssao(false),
        // Switching MSAA recompiles pipelines; wait until they are done.
        WaitReady,
        Screenshot("ssao_off"),
        Measure("ssao off", 4.0),
        Shadows(false),
        WaitReady,
        Measure("ssao off, no shadows", 4.0),
        Quit,
    ],
)
