// Lighting check: Midnight Sun (dusk): the gas station, a storage hall, a Type 98 tank.
// Views with the sun (or moon) behind and in front of the camera, the sky, our soldier in
// third person lit from the side, a building interior and a vehicle close up.
// client --scenario scenarios/lighting/light_midnight_sun.ron --out target/scenarios/light/<before|after>/midnight_sun
(
    level: "midnight_sun",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        Screenshot("spawn"),
        // Sun behind the camera: sunlit faces.
        Teleport((-199.5, 85.5, 193.1), -50.0, -4.0),
        Wait(1.5),
        Screenshot("sunlit"),
        // Facing the sun: shaded faces against the bright sky.
        Look(130.0, -4.0),
        Wait(0.5),
        Screenshot("against_sun"),
        Look(40.0, 18.0),
        Wait(0.5),
        Screenshot("sky"),
        // Our soldier, lit from the side.
        ThirdPerson(true),
        Look(40.0, -8.0),
        Wait(2.5),
        Screenshot("soldier"),
        ThirdPerson(false),
        Teleport((-327.0, 83.0, 409.0), 0.0, -2.0),
        Wait(1.5),
        Screenshot("interior"),
        NearVehicle("tnk_type98"),
        ThirdPerson(true),
        Wait(2.5),
        Screenshot("vehicle"),
        Quit,
    ],
)
