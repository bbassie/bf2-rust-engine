// Lighting A/B (each view without and with the sky light and baked occlusion, _a/_b): Strike at Karkand (day, warm): the square, the hotel (control point inside), a Humvee under the gas station roof.
// Views with the sun (or moon) behind and in front of the camera, the sky, our soldier in
// third person lit from the side, a building interior and a vehicle close up.
// client --scenario scenarios/lighting/light_ab_strike_at_karkand.ron --out target/scenarios/light/ab/strike_at_karkand
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        // Sun behind the camera: sunlit faces.
        Teleport((-184.0, 156.0, -85.0), 154.0, -4.0),
        Wait(1.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("sunlit_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("sunlit_b"),
        // Facing the sun: shaded faces against the bright sky.
        Look(-26.0, -4.0),
        Wait(0.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("against_sun_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("against_sun_b"),
        Look(244.0, 18.0),
        Wait(0.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("sky_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("sky_b"),
        // Our soldier, lit from the side.
        ThirdPerson(true),
        Look(244.0, -8.0),
        Wait(2.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("soldier_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("soldier_b"),
        ThirdPerson(false),
        Teleport((-194.4, 158.6, -11.4), 0.0, -2.0),
        Wait(1.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("interior_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("interior_b"),
        NearVehicle("usjep_hmmwv"),
        ThirdPerson(true),
        Wait(2.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("vehicle_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("vehicle_b"),
        // Frame times without and with the sky light and baked occlusion.
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(1.0),
        Measure("phase1", 5.0),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(1.0),
        Measure("phase2", 5.0),
        Quit,
    ],
)
