// Lamps indoors on a day level: Iron Gator's hangar deck and corridors, lit by their ceiling
// lights (BF2's xp1_daylightglow with its light source). Views with the lamps off and on
// (_off, _on), and frame times of both (report.txt).
// client --scenario scenarios/lighting/lamps_iron_gator.ron
(
    level: "iron_gator",
    size: 64,
    bots: 0,
    spectate: true,
    steps: [
        WaitReady,
        Wait(1.0),
        Camera((-150.0, 54.2, -170.0), 150.0, -8.0),
        Wait(1.0),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("hangar_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("hangar_on"),
        Camera((-160.0, 54.2, -196.0), 90.0, -5.0),
        Wait(1.0),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("aft_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("aft_on"),
        Camera((-110.0, 54.2, -125.0), 30.0, -5.0),
        Wait(1.0),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("fore_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("fore_on"),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("fore_off", 5.0),
        Setting("dynamic_lamps", "on"),
        Wait(1.0),
        Measure("fore_on", 5.0),
        Quit,
    ],
)
