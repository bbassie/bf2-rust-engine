// Lamps: Night Flight (night): the terminal and the street by it, the gas station, a hangar.
// Each view with the lamps off, on and on with shadows (_off, _on, _shadows), then frame times
// of each over a wide view with many lamps (report.txt).
// client --scenario scenarios/lighting/lamps_night_flight.ron
(
    level: "night_flight",
    size: 64,
    bots: 0,
    spectate: true,
    steps: [
        WaitReady,
        Wait(1.0),
        Camera((-35.7, 21.3, -138.2), 131.4, -3.2),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("terminal_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("terminal_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("terminal_shadows"),
        Camera((-35.7, 21.3, -138.2), -49.5, -3.1),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("street_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("street_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("street_shadows"),
        Camera((160.0, 21.4, -290.0), -57.4, 1.5),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("gas_station_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("gas_station_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("gas_station_shadows"),
        Camera((-110.0, 21.4, -255.0), 36.0, 4.0),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("hangar_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("hangar_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("hangar_shadows"),
        Camera((40.0, 80.0, -40.0), 32.0, -17.6),
        Setting("dynamic_lamps", "off"),
        Wait(3.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Screenshot("wide_off"),
        Measure("wide_off", 5.0),
        Setting("dynamic_lamps", "on"),
        Wait(1.0),
        Screenshot("wide_on"),
        Measure("wide_on", 5.0),
        Setting("dynamic_lamps", "shadows"),
        Wait(1.0),
        Screenshot("wide_shadows"),
        Measure("wide_shadows", 5.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("wide_off_again", 5.0),
        Camera((-35.7, 21.3, -138.2), 131.4, -3.2),
        Wait(3.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("terminal_off", 5.0),
        Setting("dynamic_lamps", "on"),
        Wait(1.0),
        Measure("terminal_on", 5.0),
        Setting("dynamic_lamps", "shadows"),
        Wait(1.0),
        Measure("terminal_shadows", 5.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("terminal_off_again", 5.0),
        Quit,
    ],
)
