// Lighting A/B (each view without and with the sky light and baked occlusion, _a/_b): Gulf of Oman (day, blue shade): the city, a storage hall, a LAV-25.
// Views with the sun (or moon) behind and in front of the camera, the sky, our soldier in
// third person lit from the side, a building interior and a vehicle close up.
// client --scenario scenarios/lighting/light_ab_gulf_of_oman.ron --out target/scenarios/light/ab/gulf_of_oman
(
    level: "gulf_of_oman",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        // Sun behind the camera: sunlit faces.
        Teleport((124.8, 38.0, 46.1), 136.0, -4.0),
        Wait(1.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("sunlit_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("sunlit_b"),
        // Facing the sun: shaded faces against the bright sky.
        Look(-44.0, -4.0),
        Wait(0.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("against_sun_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("against_sun_b"),
        Look(226.0, 18.0),
        Wait(0.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("sky_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("sky_b"),
        // Our soldier, lit from the side.
        ThirdPerson(true),
        Look(226.0, -8.0),
        Wait(2.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("soldier_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("soldier_b"),
        ThirdPerson(false),
        Teleport((-217.0, 36.3, -71.0), 0.0, -2.0),
        Wait(1.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("interior_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("interior_b"),
        NearVehicle("usapc_lav25"),
        ThirdPerson(true),
        Wait(2.5),
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(0.4),
        Screenshot("vehicle_a"),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(0.6),
        Screenshot("vehicle_b"),
        // Frame times without and with the sky light and baked occlusion.
        Setting("sky_light", "off"),
        Setting("baked_ao", "off"),
        Wait(1.0),
        Measure("phase1", 5.0),
        Setting("sky_light", "on"),
        Setting("baked_ao", "on"),
        Wait(1.0),
        Measure("phase2", 5.0),
        Quit,
    ],
)
