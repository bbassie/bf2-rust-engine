// Lamps: Leviathan (night): the sub pens, the supply depot, a crane.
// Each view with the lamps off, on and on with shadows (_off, _on, _shadows), then frame times
// of each over a wide view with many lamps (report.txt).
// client --scenario scenarios/lighting/lamps_leviathan.ron
(
    level: "leviathan",
    size: 64,
    bots: 0,
    spectate: true,
    steps: [
        WaitReady,
        Wait(1.0),
        Camera((-40.0, 46.3, -168.0), 46.1, 2.1),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("pen_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("pen_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("pen_shadows"),
        Camera((40.0, 46.4, 275.0), 40.5, 1.8),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("depot_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("depot_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("depot_shadows"),
        Camera((-130.0, 46.4, -160.0), 43.4, 8.8),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("tower_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("tower_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("tower_shadows"),
        Camera((0.0, 70.0, -60.0), 35.5, -8.3),
        Setting("dynamic_lamps", "off"),
        Wait(3.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Screenshot("wide_off"),
        Measure("wide_off", 5.0),
        Setting("dynamic_lamps", "on"),
        Wait(1.0),
        Screenshot("wide_on"),
        Measure("wide_on", 5.0),
        Setting("dynamic_lamps", "shadows"),
        Wait(1.0),
        Screenshot("wide_shadows"),
        Measure("wide_shadows", 5.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("wide_off_again", 5.0),
        Camera((-40.0, 46.3, -168.0), 46.1, 2.1),
        Wait(3.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("pen_off", 5.0),
        Setting("dynamic_lamps", "on"),
        Wait(1.0),
        Measure("pen_on", 5.0),
        Setting("dynamic_lamps", "shadows"),
        Wait(1.0),
        Measure("pen_shadows", 5.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("pen_off_again", 5.0),
        Quit,
    ],
)
