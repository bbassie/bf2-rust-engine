// Lamps: Devil's Perch (night): the harbour square, the hill village, the market.
// Each view with the lamps off, on and on with shadows (_off, _on, _shadows), then frame times
// of each over a wide view with many lamps (report.txt).
// client --scenario scenarios/lighting/lamps_devils_perch.ron
(
    level: "devils_perch",
    size: 64,
    bots: 0,
    spectate: true,
    steps: [
        WaitReady,
        Wait(1.0),
        Camera((-346.0, 14.8, 138.0), 47.2, 3.4),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("square_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("square_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("square_shadows"),
        Camera((-520.0, 77.5, 220.0), 47.0, -1.3),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("village_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("village_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("village_shadows"),
        Camera((-368.0, 15.6, 168.0), 33.9, -4.3),
        Setting("dynamic_lamps", "off"),
        Wait(0.6),
        Screenshot("market_off"),
        Setting("dynamic_lamps", "on"),
        Wait(0.6),
        Screenshot("market_on"),
        Setting("dynamic_lamps", "shadows"),
        Wait(0.6),
        Screenshot("market_shadows"),
        Camera((-300.0, 45.0, 60.0), 140.2, -10.9),
        Setting("dynamic_lamps", "off"),
        Wait(3.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Screenshot("wide_off"),
        Measure("wide_off", 5.0),
        Setting("dynamic_lamps", "on"),
        Wait(1.0),
        Screenshot("wide_on"),
        Measure("wide_on", 5.0),
        Setting("dynamic_lamps", "shadows"),
        Wait(1.0),
        Screenshot("wide_shadows"),
        Measure("wide_shadows", 5.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("wide_off_again", 5.0),
        Camera((-346.0, 14.8, 138.0), 47.2, 3.4),
        Wait(3.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("square_off", 5.0),
        Setting("dynamic_lamps", "on"),
        Wait(1.0),
        Measure("square_on", 5.0),
        Setting("dynamic_lamps", "shadows"),
        Wait(1.0),
        Measure("square_shadows", 5.0),
        Setting("dynamic_lamps", "off"),
        Wait(1.0),
        Measure("square_off_again", 5.0),
        Quit,
    ],
)
