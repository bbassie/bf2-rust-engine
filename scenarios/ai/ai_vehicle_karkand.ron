// Bots in vehicles on Karkand (64): squads take the jeeps, APCs and tanks at their spawns and
// drive to their objectives; gunners man the turrets. The camera chases the fastest bot-driven
// land vehicle for each screenshot, and looks at the Train Accident and Suburb spawns. The
// log has the per-minute "bots in vehicles" and "ai team ... vehicles:" lines.
// client --scenario scenarios/ai/ai_vehicle_karkand.ron
(
    level: "strike_at_karkand",
    size: 64,
    bots: 32,
    spectate: true,
    steps: [
        WaitReady,
        Camera((-150.0, 175.0, -300.0), 20.0, -25.0),
        Wait(12.0),
        Screenshot("train_spawn_12s"),
        ChaseDriven("land", 16.0, 7.0),
        Screenshot("chase_1"),
        Wait(8.0),
        ChaseDriven("land", 16.0, 7.0),
        Screenshot("chase_2"),
        Wait(8.0),
        ChaseDriven("land", 16.0, 7.0),
        Screenshot("chase_3"),
        Camera((-300.0, 190.0, -170.0), 150.0, -30.0),
        Wait(6.0),
        Screenshot("suburb"),
        Wait(20.0),
        ChaseDriven("land", 16.0, 7.0),
        Screenshot("chase_4"),
        Wait(10.0),
        ChaseDriven("land", 20.0, 9.0),
        Screenshot("chase_5"),
        LogVehicles("after 80 s"),
        Wait(30.0),
        ChaseDriven("land", 20.0, 9.0),
        Screenshot("chase_6"),
        Quit,
    ],
)
