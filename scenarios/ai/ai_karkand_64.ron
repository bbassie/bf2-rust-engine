// Bot strategy at scale: 32 bots on Karkand's 64 player layout for seven minutes, for the
// per-minute "ai team" and "bots" statistics in the log (captures, kills, orders, time at
// objectives, stuck events, ladders, think time). The dedicated server gives the same
// numbers without rendering: server --level strike_at_karkand --size 64 --bots 32
// client --scenario scenarios/ai/ai_karkand_64.ron --size 64 --out target/scenarios/ai/karkand_64
(
    level: "strike_at_karkand",
    bots: 32,
    spectate: true,
    steps: [
        WaitReady,
        Camera((-200.0, 260.0, 90.0), 0.0, -45.0),
        Wait(120.0),
        Screenshot("overview_2min"),
        Camera((-60.0, 260.0, -120.0), 30.0, -45.0),
        Wait(120.0),
        Screenshot("east_4min"),
        Wait(185.0),
        Screenshot("east_7min"),
        Quit,
    ],
)
