// Settings pages: change a few settings, rebind a key, and let them save.
// client --scenario scenarios/menu_settings.ron --out target/scenarios/menu/settings
//     --settings target/scenarios/menu/settings/settings.ron
(
    menu: true,
    steps: [
        WaitReady,
        Click("menu:settings"),
        Wait(0.3),
        Click("step:fov:+"),
        Frames(1),
        Click("step:fov:+"),
        Frames(1),
        Click("step:fov:+"),
        Click("toggle:invert_y"),
        Click("step:sensitivity:+"),
        Wait(0.3),
        Screenshot("game"),
        Click("tab:graphics"),
        Wait(0.3),
        Click("toggle:ssao"),
        Wait(0.3),
        Screenshot("graphics"),
        Click("tab:audio"),
        Wait(0.3),
        Click("step:volume:-"),
        Frames(1),
        Click("step:volume:-"),
        Wait(0.3),
        Screenshot("audio"),
        Click("tab:controls"),
        Wait(0.3),
        Click("bind:jump"),
        Wait(0.2),
        Screenshot("rebinding"),
        Key(KeyF),
        Wait(0.3),
        Screenshot("controls"),
        Key(Escape),
        Wait(1.0),
        Screenshot("home"),
        Quit,
    ],
)
