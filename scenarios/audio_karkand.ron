// Audio on Karkand, checked through the log (you can't hear a scenario): run with
// RUST_LOG=info,audio=debug and look for `play ...`, `culled ...` and `ambience ...` lines.
// Footsteps on the square by gait and stance, a jump landing, our rifle (fire, impacts, fire
// mode, zoom, reload, weapon switch), then the bots fighting in the distance (their fire near
// and far, impacts, deaths). `audio_combat.ron` puts us under fire.
// RUST_LOG=info,audio=debug target/debug/deps/client.exe --scenario scenarios/audio_karkand.ron --out target/scenarios/audio/karkand
(
    level: "strike_at_karkand",
    bots: 8,
    steps: [
        WaitReady,
        Teleport((-184.0, 157.0, -85.0), 180.0, -5.0),
        Wait(1.0),
        Log("run"),
        Move(0.0, 1.0),
        Wait(2.0),
        Log("sprint"),
        Hold([Sprint]),
        Wait(2.0),
        Release([Sprint]),
        Log("crouch"),
        Hold([Crouch]),
        Wait(2.0),
        Release([Crouch]),
        Log("prone"),
        Hold([Prone]),
        Wait(3.0),
        Release([Prone]),
        Move(0.0, 0.0),
        Wait(1.0),
        Log("jump"),
        Hold([Jump]),
        Wait(1.5),
        Release([Jump]),
        Log("fire"),
        Look(180.0, -3.0),
        Hold([Fire]),
        Wait(1.5),
        Release([Fire]),
        Log("fire mode"),
        Hold([FireMode]),
        Wait(0.3),
        Release([FireMode]),
        Log("zoom"),
        Hold([Aim]),
        Wait(0.5),
        Release([Aim]),
        Log("reload"),
        Hold([Reload]),
        Wait(0.3),
        Release([Reload]),
        Wait(4.0),
        Log("switch weapon"),
        Weapon(1),
        Wait(1.5),
        Weapon(2),
        Wait(1.5),
        Log("bots"),
        Wait(20.0),
        Screenshot("end"),
        Quit,
    ],
)
