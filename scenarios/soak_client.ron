// A connected client for soak tests (scripts/soak.sh): runs around, fights, opens the map,
// scoreboard and commo rose, and traces prediction corrections for a few minutes (the
// server may change maps meanwhile; the trace just pauses while loading).
// server --level strike_at_karkand --bots 32 --port 27777
// client --connect 127.0.0.1 --port 27777 --scenario scenarios/soak_client.ron --out target/scenarios/soak
(
    steps: [
        WaitReady,
        Wait(2.0),
        Screenshot("spawn"),
        Move(0.0, 1.0),
        Hold([Sprint]),
        Trace("run", 6.0),
        Release([Sprint]),
        Look(90.0, 0.0),
        Trace("walk", 4.0),
        Move(0.0, 0.0),
        TrackEnemy(8.0, 1.2),
        Hold([Fire]),
        Wait(1.5),
        Release([Fire]),
        Measure("frame", 5.0),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("map"),
        ReleaseKey(KeyM),
        HoldKey(Tab),
        Wait(0.5),
        Screenshot("scoreboard"),
        ReleaseKey(Tab),
        HoldKey(KeyQ),
        Wait(0.4),
        Screenshot("rose"),
        ReleaseKey(KeyQ),
        Wait(0.3),
        Move(0.5, 1.0),
        Trace("roam", 60.0),
        Look(270.0, 0.0),
        Hold([Sprint]),
        Trace("roam_sprint", 30.0),
        Release([Sprint]),
        TrackEnemy(20.0, 1.2),
        Move(-0.5, 1.0),
        Trace("roam_back", 60.0),
        Move(0.0, 0.0),
        Measure("frame_end", 5.0),
        Screenshot("end"),
        Quit,
    ],
)
