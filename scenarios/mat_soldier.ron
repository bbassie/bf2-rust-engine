// BF2 bundled and skinned materials: first-person weapon and arms, the soldier in third
// person (pass `--tp-offset 1.6,0.2,1.2` for a closer side view).
// client --scenario scenarios/mat_soldier.ron --out target/scenarios/mat/<name>
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        // The square, looking north along the street (sun from the front right).
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Wait(1.5),
        Screenshot("fp_idle"),
        Measure("first person", 4.0),
        Hold([Aim]),
        Wait(0.6),
        Screenshot("fp_zoomed"),
        Release([Aim]),
        // Facing the sun.
        Look(-60.0, -4.0),
        Wait(1.0),
        Screenshot("fp_sun"),
        Weapon(1),
        Wait(1.5),
        Screenshot("fp_weapon1"),
        Weapon(0),
        Wait(1.5),
        ThirdPerson(true),
        Look(20.0, -4.0),
        // The third-person body's pipelines compile once it is first drawn.
        Wait(2.5),
        Screenshot("tp_back"),
        Look(200.0, -4.0),
        Wait(0.5),
        Screenshot("tp_front"),
        Look(110.0, -4.0),
        Wait(0.5),
        Screenshot("tp_side"),
        Quit,
    ],
)
