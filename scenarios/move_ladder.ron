// Ladders on Karkand: up house ladders onto the roof, back down from the roof, jumping off.
// Needs templates imported with ladder parts marked (bf2-import level strike_at_karkand).
// client --scenario scenarios/move_ladder.ron --out target/scenarios/move/ladder
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        ThirdPerson(true),

        // house_low_02, 7.8 m ladder on its north wall, climbed from the north.
        Teleport((-188.25, 157.0, -248.3), 180.0, 10.0),
        Wait(1.0),
        Screenshot("low_bottom"),
        Move(0.0, 1.0),
        Trace("low_up", 2.5),
        Screenshot("low_climbing"),
        ThirdPerson(false),
        Wait(0.1),
        Screenshot("low_climbing_1p"),
        ThirdPerson(true),
        Trace("low_top", 5.5),
        Screenshot("low_roof"),
        Move(0.0, 0.0),

        // Turn around and get back on from the roof, looking down: down to the street.
        Look(0.0, -40.0),
        Wait(0.3),
        Move(0.0, 1.0),
        Trace("low_down", 4.0),
        Screenshot("low_down"),
        Move(0.0, 0.0),

        // Up halfway, then jump off.
        Look(180.0, 10.0),
        Move(0.0, 1.0),
        Trace("low_again", 2.5),
        Hold([Jump]),
        Trace("low_jump_off", 1.5),
        Release([Jump]),
        Move(0.0, 0.0),
        Screenshot("low_jumped_off"),

        // house_medium_04, 4.5 m ladder, climbed from the west.
        Teleport((-188.6, 158.0, -217.88), -90.0, 10.0),
        Wait(1.0),
        Move(0.0, 1.0),
        Trace("medium_up", 5.5),
        Screenshot("medium_roof"),
        Move(0.0, 0.0),
        Quit,
    ],
)
