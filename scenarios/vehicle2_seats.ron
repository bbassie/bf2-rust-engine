// Seated soldiers in their seat poses: driver and gunner of a Vodnik on Karkand, seen from
// outside (third person) and from the gunner's seat looking at the driver.
// client --scenario scenarios/vehicle2_seats.ron --out target/scenarios/vehicle2/seats
(
    level: "strike_at_karkand",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("jep_vodnik"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        ThirdPerson(true),
        VehicleLook(120.0, -15.0),
        Wait(1.0),
        Screenshot("01_driver"),
        VehicleLook(-90.0, -5.0),
        Wait(0.5),
        Screenshot("01_driver_side"),
        VehicleLook(180.0, -5.0),
        Wait(0.5),
        Screenshot("01_driver_front"),
        Seat(2),
        Wait(1.0),
        VehicleLook(150.0, -15.0),
        Wait(1.0),
        Screenshot("02_gunner"),
        VehicleInfo("gunner"),
        Quit,
    ],
)
