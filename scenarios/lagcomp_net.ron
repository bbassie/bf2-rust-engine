// Lag compensation against a dedicated server with bots: we keep our rifle on the chest of
// the nearest enemy in sight as drawn here (100 ms in the past, plus the simulated input
// delay) and fire. The server logs every hit and how many ticks back it was judged
// (RUST_LOG=info,game_server::combat=debug). Compare with BF2_NO_LAG_COMPENSATION=1 on the
// server.
// server --level strike_at_karkand --size 16 --bots 12 --port 16602
// BF2_SIM_INPUT_DELAY_MS=100 client --connect 127.0.0.1 --port 16602 --scenario scenarios/lagcomp_net.ron --out target/scenarios/lagcomp/on
(
    steps: [
        WaitReady,
        Wait(3.0),
        // A few shots anywhere, for the rewind the server logs.
        Hold([Fire]),
        Wait(1.0),
        Release([Fire]),
        TrackEnemy(180.0, 1.2),
        Quit,
    ],
)
