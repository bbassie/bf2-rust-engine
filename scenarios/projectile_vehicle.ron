// Explosives against vehicles at the US main base on Strike at Karkand: C4 stuck to the
// LAV-25 and set off from a distance, a hand grenade next to it, then a Predator (SRAW)
// rocket into it. Vehicle damage (direct hits through the hull armor material, blasts
// through its blast sensitivity, both from BF2's damage table) is logged by
// `game_server::combat`.
// client --scenario scenarios/projectile_vehicle.ron --out target/scenarios/projectile/vehicle
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        Wait(1.0),
        Click("kit:0"),
        Wait(16.0),
        NearVehicle("usapc_lav25"),
        Weapon(2),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.5),
        Screenshot("c4_on_lav"),
        Move(0.0, -1.0),
        Wait(2.5),
        Move(0.0, 0.0),
        Hold([Aim]),
        Wait(0.1),
        Release([Aim]),
        Wait(0.3),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.2),
        Screenshot("c4_boom"),
        Wait(1.0),
        Weapon(1),
        Wait(1.2),
        Hold([Fire]),
        Wait(0.2),
        Release([Fire]),
        Wait(4.0),
        Kill,
        Wait(1.0),
        Click("kit:6"),
        Wait(16.0),
        // Point blank into the hull (the blast gets us too).
        NearVehicle("usapc_lav25"),
        Weapon(0),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Screenshot("sraw_hit"),
        Wait(1.0),
        Quit,
    ],
)
