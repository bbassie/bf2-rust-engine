// Grenades against a dedicated server: the thrower's smoke grenade and GP-30 shell show at
// once (predicted), the server's replicated projectiles take over, smoke and explosions
// come from the server. The default (assault) kit, from wherever we spawn.
// server --level strike_at_karkand --port 16601 > server.log
// client --connect 127.0.0.1 --port 16601 --scenario scenarios/projectile_net.ron --out target/scenarios/projectile/net
(
    steps: [
        WaitReady,
        Wait(2.0),
        Weapon(5),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.75),
        Screenshot("net_smoke_thrown"),
        Wait(4.5),
        Screenshot("net_smoke"),
        Weapon(1),
        Wait(2.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.15),
        Screenshot("net_gp30"),
        Wait(2.0),
        Quit,
    ],
)
