// Grappling hook on Warlord (SAS assault kit, which carries BF2 SF's hook): thrown at the
// office building's roof, it flies with its 26 links trailing, catches on the edge, the rope
// swings in over it and settles (then sleeps), seen from the side; climbed, with the rope
// clipped onto the climber, and got off over the edge onto the roof. Then a throw that finds
// no ledge (the hook falls back and lies in the street with its rope), one onto a toolshed's
// sloped roof, and frame times with five ropes up.
// client --scenario scenarios/movement/grapple.ron --out target/scenarios/move/grapple
(
    level: "warlord",
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        // 15 m south of the office building (its roof is 11 m up), throwing high over
        // its edge, in first person to watch the hook fly with its links trailing.
        Teleport((99.0, 96.0, 190.0), 0.0, 50.0),
        Wait(2.0),
        Weapon(8),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.3),
        Release([Fire]),
        Wait(0.65),
        Screenshot("throw_1"),
        Wait(0.15),
        Screenshot("throw_2"),
        Wait(0.15),
        Screenshot("throw_3"),
        ExpectLog("strung a Grapple rope", 4.0),
        // The rope swinging in over the edge and settling, from the side.
        ThirdPerson(true),
        ViewRope(5.0, 60.0),
        Wait(0.1),
        Screenshot("swing_1"),
        Wait(0.3),
        Screenshot("swing_2"),
        Wait(0.3),
        Screenshot("swing_3"),
        Wait(0.6),
        Screenshot("swing_4"),
        Wait(1.0),
        Screenshot("swing_5"),
        ExpectLog("grapple rope settled", 8.0),
        ViewRope(9.0, 70.0),
        Wait(1.5),
        Screenshot("side"),
        ViewRope(4.0, 10.0),
        Wait(1.0),
        Screenshot("front"),

        // Up the rope, looking along the wall so the camera sees it from the side.
        ViewRope(0.9, 0.0),
        Wait(1.0),
        Move(0.0, 1.0),
        Trace("to_rope", 1.0),
        Look(270.0, 5.0),
        Trace("climb", 1.0),
        Screenshot("climb_1"),
        Trace("climb", 1.0),
        Screenshot("climb_2"),
        Trace("climb", 1.2),
        Screenshot("climb_3"),
        Trace("top", 0.4),
        Screenshot("over_edge"),
        Trace("top", 1.5),
        Move(0.0, 0.0),
        Look(180.0, -30.0),
        Wait(0.5),
        Screenshot("roof"),

        // A flat throw at a wall: nothing to hook over, it bounces off and falls back.
        // (One hook per life: respawned as assault, the third kit here, to throw again.)
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:2"),
        WaitReady,
        Teleport((104.0, 96.0, 175.0), 0.0, 3.0),
        Wait(1.5),
        Weapon(8),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.3),
        Release([Fire]),
        Wait(0.75),
        Screenshot("miss_flying"),
        ExpectLog("nothing to string a rope over", 5.0),
        Look(0.0, -20.0),
        Wait(0.3),
        Screenshot("miss_lying"),
        Kill,
        Wait(1.0),
        Click("kit:2"),
        WaitReady,

        // Onto the sloped (13°) roof of a toolshed, from 7 m east of its low eave.
        Teleport((-90.5, 100.5, 97.5), 90.0, 18.0),
        Wait(1.5),
        Weapon(8),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.3),
        Release([Fire]),
        ExpectLog("strung a Grapple rope", 5.0),
        Wait(1.0),
        Screenshot("sloped_swing"),
        ExpectLog("grapple rope settled", 8.0),
        ViewRope(6.0, 60.0),
        Wait(1.0),
        Screenshot("sloped"),

        // Frame times: our rope and four more beside it, swinging in, then asleep.
        ExtraRopes(4),
        Wait(0.1),
        Measure("five_ropes_swinging", 2.0),
        Screenshot("five_ropes"),
        Wait(6.0),
        Measure("five_ropes_asleep", 2.0),
        Quit,
    ],
)
