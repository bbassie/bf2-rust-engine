// Soldier movement on Karkand: curbs, slopes, ramps, stances, jumps. `Trace` steps log the
// movement state every frame to report.txt (airborne frames, dips, speed, prediction error).
// client --scenario scenarios/movement/move_karkand.ron --out target/scenarios/move/karkand
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        ThirdPerson(true),

        // South across the square and over the sidewalk curb.
        Teleport((-184.0, 157.0, -85.0), 180.0, -10.0),
        Wait(1.0),
        Move(0.0, 1.0),
        Trace("south", 6.0),
        Screenshot("south"),
        Move(0.0, 0.0),

        // Sprinting west over the sidewalks towards the houses.
        Teleport((-184.0, 157.0, -85.0), 90.0, -10.0),
        Wait(1.0),
        Hold([Sprint]),
        Move(0.0, 1.0),
        Trace("west_sprint", 3.5),
        Screenshot("west_sprint"),
        Release([Sprint]),
        Move(0.0, 0.0),

        // North up the slope towards the canal wall.
        Teleport((-184.0, 157.0, -85.0), 0.0, -10.0),
        Wait(1.0),
        Move(0.0, 1.0),
        Trace("north", 7.0),
        Screenshot("north"),
        Move(0.0, 0.0),

        // Onto the metal plate ramp.
        Teleport((-201.2, 157.0, -96.0), 0.0, -10.0),
        Wait(1.0),
        Move(0.0, 1.0),
        Trace("ramp", 4.0),
        Screenshot("ramp"),
        Move(0.0, 0.0),

        // Crouched and prone across the square.
        Teleport((-184.0, 157.0, -85.0), 200.0, -10.0),
        Hold([Crouch]),
        Wait(1.0),
        Move(0.0, 1.0),
        Trace("crouch", 3.0),
        Release([Crouch]),
        Hold([Prone]),
        Trace("prone", 3.0),
        Screenshot("prone"),
        Release([Prone]),
        Move(0.0, 0.0),

        // Into the barrack at the eastern spawn, jump onto its 0.6 m ledge and keep pushing
        // against the wall above it: should rest still, not jitter.
        Teleport((226.73, 153.5, -181.0), 0.0, 0.0),
        Wait(1.0),
        Hold([Sprint]),
        Move(0.0, 1.0),
        Wait(1.5),
        Hold([Jump]),
        Trace("ledge", 3.0),
        Release([Jump, Sprint]),
        Move(0.0, 0.0),

        // Standing jump, then a running jump with the button held (one jump only). Getting
        // up from prone blocks jumping for 0.8 s, and a press during that is lost.
        Teleport((-184.0, 157.0, -85.0), 180.0, 0.0),
        Wait(1.5),
        Hold([Jump]),
        Trace("jump_standing", 1.5),
        Release([Jump]),
        Move(0.0, 1.0),
        Wait(0.6),
        Hold([Jump]),
        Trace("jump_running", 2.0),
        Screenshot("jump_running"),
        Release([Jump]),
        Move(0.0, 0.0),
        Quit,
    ],
)
