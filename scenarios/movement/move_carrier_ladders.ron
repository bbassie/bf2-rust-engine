// Dalian Plant's carrier: the US spawn points on the starboard catwalk, 1.4 m below the
// flight deck, and the short ladders up to the deck (`us_carrier_wasp_back_ladder04`, children
// of the carrier's template: bf2-import level dalian_plant).
// client --scenario scenarios/movement/move_carrier_ladders.ron
(
    level: "dalian_plant",
    size: 32,
    bots: 0,
    team: 2,
    steps: [
        WaitReady,
        ThirdPerson(true),

        // Spawn point at (796, 160.7, -14), facing the carrier (west): the hull is in the way.
        Teleport((796.0, 160.695, -14.0), 90.0, 5.0),
        Wait(1.0),
        Screenshot("spawn_a"),
        Move(0.0, 1.0),
        Trace("a_hull", 0.6),
        Move(0.0, 0.0),

        // Along the catwalk (south) to the ladder at z -11.3 and up it onto the deck.
        Teleport((796.0, 160.695, -11.3), 90.0, 10.0),
        Wait(0.3),
        Move(0.0, 1.0),
        Trace("a_up", 3.0),
        Move(0.0, 0.0),
        Screenshot("a_deck"),

        // Spawn point at (796, 160.7, 2): the ladder at z -2.5.
        Teleport((796.0, 160.695, 2.0), 90.0, 5.0),
        Wait(1.0),
        Screenshot("spawn_b"),
        Teleport((796.0, 160.695, -2.5), 90.0, 10.0),
        Wait(0.3),
        Move(0.0, 1.0),
        Trace("b_up", 3.0),
        Move(0.0, 0.0),
        Screenshot("b_deck"),

        // And back down from the deck: walk over the edge onto the ladder, looking down.
        Teleport((794.6, 162.1, -2.5), -90.0, -40.0),
        Wait(0.5),
        Move(0.0, 1.0),
        Trace("b_down", 3.0),
        Move(0.0, 0.0),
        Screenshot("b_catwalk_again"),
        Quit,
    ],
)
