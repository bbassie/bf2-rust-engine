// Gamepad infantry controls: connect a synthetic pad (see scenarios/menu/gamepad_nav.ron),
// walk with the left stick, look with the right stick, jump with South, switch to the
// secondary weapon with North, and fire with the right trigger.
// client --scenario scenarios/movement/move_gamepad.ron --out target/scenarios/movement/gamepad
(
    level: "test_range",
    bots: 0,
    steps: [
        WaitReady,
        GamepadConnect,
        Wait(0.3),
        Screenshot("start"),
        GamepadLeftStick(0.0, 1.0),
        Wait(1.0),
        Trace("walking", 0.5),
        Screenshot("walking"),
        GamepadRightStick(0.7, 0.0),
        Wait(0.5),
        GamepadRightStick(0.0, 0.0),
        Screenshot("turned"),
        GamepadHold([South]),
        Wait(0.15),
        GamepadRelease([South]),
        Wait(0.6),
        Trace("jumped", 0.5),
        GamepadLeftStick(0.0, 0.0),
        GamepadHold([North]),
        Wait(0.2),
        GamepadRelease([North]),
        Wait(0.3),
        Screenshot("switched_weapon"),
        GamepadTriggers(0.0, 1.0),
        Wait(0.3),
        Screenshot("firing"),
        GamepadTriggers(0.0, 0.0),
        GamepadDisconnect,
        Quit,
    ],
)
