// Main menu -> singleplayer on Karkand -> in-game menu -> leave -> a second match from the
// menu, to check that leaving tears the match down cleanly.
// client --scenario scenarios/menu_play.ron --out target/scenarios/menu/play
(
    menu: true,
    steps: [
        WaitReady,
        Screenshot("home"),
        Click("menu:play"),
        Wait(0.3),
        Click("level:strike_at_karkand"),
        Wait(0.3),
        Click("layout:gpm_cq:32"),
        Click("team:2"),
        // One click per frame: several on the same button in one frame count once.
        Click("step:bots:-"),
        Frames(1),
        Click("step:bots:-"),
        Frames(1),
        Click("step:bots:-"),
        WaitReady,
        Screenshot("play"),
        Click("start"),
        Frames(1),
        Screenshot("loading"),
        WaitReady,
        Wait(1.0),
        Screenshot("in_game"),
        Key(Escape),
        Wait(0.3),
        Screenshot("paused"),
        Click("menu:settings"),
        Wait(0.3),
        Screenshot("paused_settings"),
        Key(Escape),
        Wait(0.2),
        Click("pause:leave"),
        Wait(0.5),
        WaitReady,
        Screenshot("left"),
        Click("menu:play"),
        Wait(0.3),
        Click("level:test_range"),
        Wait(0.3),
        Click("start"),
        WaitReady,
        Wait(1.0),
        Screenshot("second_match"),
        Quit,
    ],
)
