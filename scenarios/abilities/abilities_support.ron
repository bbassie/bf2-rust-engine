// Support on Strike at Karkand: after emptying some of the RPK, the ammo bag in hand
// resupplies us (5.3 % of full ammo per second), then a thrown bag refills the rest.
// client --scenario scenarios/abilities/abilities_support.ron --out target/scenarios/abilities/support
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:3"),
        WaitSpawned(20.0),
        Teleport((-184.0, 157.0, -85.0), 180.0, 5.0),
        Weapon(4),
        Wait(2.0),
        Hold([Fire]),
        Wait(4.0),
        Release([Fire]),
        Wait(4.0),
        Hold([Fire]),
        Wait(4.0),
        Release([Fire]),
        Vitals("fired"),
        Weapon(3),
        Wait(1.0),
        Vitals("bag_in_hand"),
        Wait(4.0),
        Vitals("resupplied_4s"),
        Screenshot("resupplying"),
        Look(180.0, -70.0),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.8),
        Move(0.0, 0.5),
        Wait(0.6),
        Move(0.0, 0.0),
        Wait(1.0),
        Vitals("picked_up"),
        Quit,
    ],
)
