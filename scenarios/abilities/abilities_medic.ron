// The medic on Strike at Karkand with bots: a teammate is critically wounded in front of us
// (the marker over his body), the shock paddles bring him back (restoreHP 120, +2 score);
// the medic bag in hand heals us (5.3 % per second), a thrown one is picked up at once.
// client --scenario scenarios/abilities/abilities_medic.ron --out target/scenarios/abilities/medic
(
    level: "strike_at_karkand",
    bots: 8,
    steps: [
        WaitReady,
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:5"),
        WaitSpawned(20.0),
        Teleport((-184.0, 157.0, -85.0), 180.0, -10.0),
        Wait(1.0),
        Summon(0.0),
        Wait(1.5),
        Screenshot("downed_teammate"),
        Vitals("downed"),
        // Shock paddles, aimed at the body.
        Weapon(1),
        Look(180.0, -50.0),
        Wait(1.0),
        Screenshot("paddles"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.5),
        Vitals("revived"),
        ThirdPerson(true),
        Wait(0.5),
        Screenshot("revived"),
        ThirdPerson(false),
        // Medic bag in hand: healing ourselves.
        Hurt(60.0),
        Weapon(0),
        Wait(1.0),
        Vitals("hurt"),
        Wait(4.0),
        Vitals("healed_4s"),
        Screenshot("healing"),
        // A thrown bag, picked up after its 2 s arming delay.
        Hurt(50.0),
        Look(180.0, -70.0),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.8),
        Screenshot("bag"),
        Move(0.0, 0.5),
        Wait(0.6),
        Move(0.0, 0.0),
        Wait(2.5),
        Vitals("picked_up"),
        Quit,
    ],
)
