// Bots against a vehicle: we sit in the MEC Vodnik at the Square while the US bots attack
// through the Hotel; their anti-tank bots fire (wire-guided) rockets at it, steering them
// by keeping it in their sights, and MEC engineer bots come to repair it. The log has the
// rockets ("fires usatp_predator") and the per-minute "ai team" lines (rockets, repairs).
// client --scenario scenarios/ai_rockets.ron --out target/scenarios/ai/rockets
(
    level: "strike_at_karkand",
    size: 64,
    team: 1,
    bots: 32,
    steps: [
        WaitReady,
        Wait(2.0),
        Teleport((-243.0, 156.0, -106.0), 90.0, 0.0),
        Wait(1.0),
        NearVehicle("jep_vodnik"),
        Wait(1.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        VehicleInfo("entered"),
        Wait(90.0),
        VehicleInfo("90 s"),
        Screenshot("90s"),
        Wait(75.0),
        VehicleInfo("165 s"),
        Screenshot("165s"),
        Wait(75.0),
        VehicleInfo("240 s"),
        Screenshot("240s"),
        Quit,
    ],
)
