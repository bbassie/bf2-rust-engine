// Conquest HUD and the deploy screen: die, pick a kit and a flag, respawn there.
// client --scenario scenarios/conquest.ron
(
    level: "strike_at_karkand",
    bots: 8,
    steps: [
        WaitReady,
        Wait(1.0),
        Screenshot("hud"),
        Kill,
        Wait(1.0),
        Screenshot("deploy"),
        Click("kit:5"),
        Click("cp:1"),
        Wait(0.5),
        Screenshot("deploy_selected"),
        Wait(10.0),
        Screenshot("respawned"),
        Quit,
    ],
)
