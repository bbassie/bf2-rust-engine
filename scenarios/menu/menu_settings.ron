// Settings pages: change a few settings, rebind a key, and let them save.
// client --scenario scenarios/menu/menu_settings.ron --out target/scenarios/menu/settings
//     --settings target/scenarios/menu/settings/settings.ron
(
    menu: true,
    steps: [
        WaitReady,
        Click("menu:settings"),
        Wait(0.3),
        Click("step:fov:+"),
        Frames(1),
        Click("step:fov:+"),
        Frames(1),
        Click("step:fov:+"),
        Click("toggle:invert_y"),
        Click("step:sensitivity:+"),
        Wait(0.3),
        Screenshot("game"),
        Click("tab:graphics"),
        Wait(0.3),
        Click("ssaoquality:off"),
        Wait(0.3),
        Screenshot("graphics"),
        // Applied live: this screenshot is 1600x900.
        Click("size:1600x900"),
        Wait(1.0),
        Screenshot("graphics_1600x900"),
        Click("size:1280x720"),
        Wait(1.0),
        // Picking a preset overrides the individual choices above.
        Click("preset:ultra"),
        Wait(0.3),
        Screenshot("preset_ultra"),
        Click("preset:high"),
        Wait(0.3),
        Click("tab:gamepad"),
        Wait(0.3),
        Screenshot("gamepad_tab"),
        Click("tab:audio"),
        Wait(0.3),
        Click("step:volume:-"),
        Frames(1),
        Click("step:volume:-"),
        Wait(0.3),
        Screenshot("audio"),
        Click("tab:controls"),
        Wait(0.3),
        Click("bind:jump"),
        Wait(0.2),
        Screenshot("rebinding"),
        Key(KeyF),
        Wait(0.3),
        // A secondary binding for the same action, and clearing/rebinding its gamepad button.
        Click("bind2:jump"),
        Wait(0.2),
        Key(KeyG),
        Wait(0.2),
        Click("bindpad:jump:clear"),
        Wait(0.2),
        Screenshot("controls"),
        Click("bind:reset"),
        Wait(0.3),
        Key(Escape),
        Wait(1.0),
        Screenshot("home"),
        Quit,
    ],
)
