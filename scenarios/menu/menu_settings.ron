// Settings pages: change a few settings, rebind a key, and let them save.
// client --scenario scenarios/menu/menu_settings.ron --out target/scenarios/menu/settings
//     --settings target/scenarios/menu/settings/settings.ron
(
    menu: true,
    steps: [
        WaitReady,
        Click("menu:settings"),
        Wait(0.3),
        Click("step:fov:+"),
        Frames(1),
        Click("step:fov:+"),
        Frames(1),
        Click("step:fov:+"),
        Click("toggle:invert_y"),
        Click("step:sensitivity:+"),
        Wait(0.3),
        Screenshot("game"),
        Click("tab:graphics"),
        Wait(0.3),
        Click("ssaoquality:off"),
        Wait(0.3),
        Screenshot("graphics"),
        // Applied live: this screenshot is 1600x900.
        Click("size:1600x900"),
        Wait(1.0),
        Screenshot("graphics_1600x900"),
        Click("size:1280x720"),
        Wait(1.0),
        // Picking a preset overrides the individual choices above.
        Click("preset:ultra"),
        Wait(0.3),
        Screenshot("preset_ultra"),
        Click("preset:high"),
        Wait(0.3),
        Click("tab:gamepad"),
        Wait(0.3),
        Screenshot("gamepad_tab"),
        Click("tab:audio"),
        Wait(0.3),
        Click("step:volume:-"),
        Frames(1),
        Click("step:volume:-"),
        Wait(0.3),
        Screenshot("audio"),
        Click("tab:controls"),
        Wait(0.3),
        Click("bind:jump"),
        Wait(0.2),
        Screenshot("rebinding"),
        Key(KeyF),
        Wait(0.3),
        // A secondary binding for the same action, and clearing/rebinding its gamepad button.
        Click("bind2:jump"),
        Wait(0.2),
        Key(KeyG),
        Wait(0.2),
        Click("bindpad:jump:clear"),
        Wait(0.2),
        Screenshot("controls"),
        Click("bind:reset"),
        Wait(0.3),

        // Every tab, at both sizes, scrolled to the bottom: the tab bar and the Back button
        // must stay put and the last row must be reachable (see `menu::pages::settings_page`'s
        // `ScrollArea` + `Scrollbar`, and `PageRoot`'s `min_height: px(0)`). The window size
        // buttons are on the Graphics tab, so switch there first each time.
        Click("tab:graphics"),
        Wait(0.2),
        Click("size:1280x720"),
        Wait(0.5),
        Click("tab:game"),
        Wait(0.3),
        Screenshot("720_game_top"),
        ScrollIntoView("content:confirm-new"),
        Wait(0.3),
        Screenshot("720_game_bottom"),
        Click("tab:graphics"),
        Wait(0.3),
        Screenshot("720_graphics_top"),
        ScrollIntoView("tonemap:neutral"),
        Wait(0.3),
        Screenshot("720_graphics_bottom"),
        Click("tab:audio"),
        Wait(0.3),
        Screenshot("720_audio_top"),
        ScrollIntoView("voice:output"),
        Wait(0.3),
        Screenshot("720_audio_bottom"),
        Click("tab:controls"),
        Wait(0.3),
        Screenshot("720_controls_top"),
        ScrollIntoView("bind:reset"),
        Wait(0.3),
        Screenshot("720_controls_bottom"),
        Click("tab:gamepad"),
        Wait(0.3),
        Screenshot("720_gamepad_top"),
        ScrollIntoView("toggle:gamepad_aim_assist"),
        Wait(0.3),
        Screenshot("720_gamepad_bottom"),

        Click("tab:graphics"),
        Wait(0.2),
        Click("size:1920x1080"),
        Wait(0.5),
        Click("tab:game"),
        Wait(0.3),
        Screenshot("1080_game_top"),
        ScrollIntoView("content:confirm-new"),
        Wait(0.3),
        Screenshot("1080_game_bottom"),
        Click("tab:graphics"),
        Wait(0.3),
        Screenshot("1080_graphics_top"),
        ScrollIntoView("tonemap:neutral"),
        Wait(0.3),
        Screenshot("1080_graphics_bottom"),
        Click("tab:audio"),
        Wait(0.3),
        Screenshot("1080_audio_top"),
        ScrollIntoView("voice:output"),
        Wait(0.3),
        Screenshot("1080_audio_bottom"),
        Click("tab:controls"),
        Wait(0.3),
        Screenshot("1080_controls_top"),
        ScrollIntoView("bind:reset"),
        Wait(0.3),
        Screenshot("1080_controls_bottom"),
        Click("tab:gamepad"),
        Wait(0.3),
        Screenshot("1080_gamepad_top"),
        ScrollIntoView("toggle:gamepad_aim_assist"),
        Wait(0.3),
        Screenshot("1080_gamepad_bottom"),

        Click("tab:graphics"),
        Wait(0.2),
        Click("size:1280x720"),
        Wait(0.5),
        Click("tab:game"),
        Wait(0.3),
        Key(Escape),
        Wait(1.0),
        Screenshot("home"),
        Quit,
    ],
)
