// The graphics settings' view distance presets.
// client --scenario scenarios/menu/menu_view_distance.ron --out target/scenarios/menu/view_distance
//     --settings target/scenarios/menu/view_distance/settings.ron
(
    menu: true,
    steps: [
        WaitReady,
        Click("menu:settings"),
        Wait(0.3),
        Click("tab:graphics"),
        Wait(0.3),
        Click("view:far"),
        Wait(0.3),
        Screenshot("graphics_far"),
        Click("view:normal"),
        Wait(0.6),
        Quit,
    ],
)
