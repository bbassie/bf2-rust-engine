// Joining a server that isn't there: after netcode's connect timeout we are back in the
// menu, which says why.
// client --scenario scenarios/menu/menu_join_fail.ron --out target/scenarios/menu/join_fail
(
    menu: true,
    steps: [
        WaitReady,
        Click("menu:join"),
        Wait(0.3),
        Click("connect"),
        Wait(1.0),
        Screenshot("connecting"),
        Wait(20.0),
        Screenshot("failed"),
        Quit,
    ],
)
