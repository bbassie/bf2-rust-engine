// First run of a packaged game (menu::setup): no imported content, so the welcome page opens,
// finds the BF2 install, lists its mods, imports two levels with the bundled bf2-import (quick
// start), then plays one. Needs bf2-import built next to the client and a BF2 install it can
// find (registry, common folders or $BF2_DIR). Run it against an empty data folder so your
// real content isn't touched:
// client --scenario scenarios/menu/first_run.ron --data-dir target/scenarios/first_run/data
(
    menu: true,
    steps: [
        WaitReady,
        ExpectLog("setup: no imported content", 5.0),
        ExpectLog("setup: found BF2 install", 20.0),
        ExpectLog("levels)", 20.0),
        Wait(0.3),
        Screenshot("welcome"),
        Click("setup:mod:aix2"),
        Wait(0.3),
        Screenshot("mod_selected"),
        Click("setup:mod:aix2"),
        Frames(1),
        Click("setup:quick"),
        Wait(0.3),
        Click("setup:import"),
        ExpectLog("setup: importing with", 5.0),
        Wait(2.0),
        // Cancelling stops bf2-import; "Resume import" continues (`level --resume`).
        Click("setup:cancel"),
        ExpectLog("setup: import cancelled", 10.0),
        Wait(0.3),
        Screenshot("cancelled"),
        Click("setup:import"),
        Wait(4.0),
        Screenshot("importing"),
        ExpectLog("setup: import finished", 600.0),
        ForbidLog("setup: import failed"),
        Wait(0.5),
        Screenshot("imported"),
        Click("setup:close"),
        Wait(0.5),
        ExpectLog("menu: 2 imported levels", 10.0),
        Click("menu:play"),
        Wait(0.5),
        Screenshot("play_page"),
        Click("level:strike_at_karkand"),
        Wait(0.3),
        Click("start"),
        Frames(1),
        WaitReady,
        Wait(1.0),
        Screenshot("in_game"),
        // Settings > Game > BF2 content opens the page again ("Import more...").
        Key(Escape),
        Wait(0.3),
        Click("pause:leave"),
        Wait(0.5),
        WaitReady,
        Click("menu:settings"),
        Wait(0.3),
        ScrollIntoView("setup:open"),
        Wait(0.3),
        Screenshot("settings_row"),
        Click("setup:open"),
        Wait(0.5),
        Screenshot("import_more"),
        Quit,
    ],
)
