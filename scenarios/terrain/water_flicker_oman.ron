// Water animation stability on Gulf of Oman: screenshot bursts 50 ms apart over the sea by
// the carrier (see water_flicker.ron).
// client --scenario scenarios/terrain/water_flicker_oman.ron --out target/scenarios/water_flicker/oman
(
    level: "gulf_of_oman",
    bots: 0,
    spectate: true,
    steps: [
        WaitReady,
        Camera((-620.0, 60.0, 560.0), 0.0, -35.0),
        Wait(2.0),
        Screenshot("sea_0"),
        Wait(0.05),
        Screenshot("sea_1"),
        Wait(0.05),
        Screenshot("sea_2"),
        Wait(0.05),
        Screenshot("sea_3"),
        Wait(0.05),
        Screenshot("sea_4"),
        Wait(0.05),
        Screenshot("sea_5"),
        Wait(0.05),
        Screenshot("sea_6"),
        Wait(0.05),
        Screenshot("sea_7"),
        Wait(0.05),
        Camera((-620.0, 32.0, 560.0), 90.0, -12.0),
        Wait(1.0),
        Screenshot("low_0"),
        Wait(0.05),
        Screenshot("low_1"),
        Wait(0.05),
        Screenshot("low_2"),
        Wait(0.05),
        Screenshot("low_3"),
        Wait(0.05),
        Screenshot("low_4"),
        Wait(0.05),
        Screenshot("low_5"),
        Wait(0.05),
        Screenshot("low_6"),
        Wait(0.05),
        Screenshot("low_7"),
        Wait(0.05),
        Quit,
    ],
)
