// The sample mod: Sample Valley (a level made from scratch in our formats) with the US
// assault slot carrying the sample carbine (a weapon derived from the M4 by a patch).
// client --scenario scenarios/infra/mod_sample.ron --out target/scenarios/mod/sample
(
    level: "sample_valley",
    team: 2,
    bots: 4,
    steps: [
        WaitReady,
        Wait(1.0),
        Screenshot("spawn"),
        Teleport((10.0, 20.0, 18.0), 29.0, -8.0),
        Wait(2.5),
        Screenshot("village"),
        Teleport((-98.0, 40.0, 64.0), 48.0, 2.0),
        Wait(2.5),
        Screenshot("west_hill"),
        Teleport((40.0, 20.0, -40.0), -74.0, -4.0),
        Wait(2.5),
        Screenshot("lake"),
        Hold([Fire]),
        Wait(1.0),
        Release([Fire]),
        Wait(0.2),
        Screenshot("fired"),
        Quit,
    ],
)
