// Chat, admin commands in the chat, the end-of-round summary and the map rotation on a
// dedicated server (config: a rotation of test_range and strike_at_karkand).
// server --config <dir>/server.ron      (see game_server::server_config; port 16611 below)
// client --connect 127.0.0.1 --port 16611 --name Tester --scenario scenarios/infra/infra_chat.ron --out target/scenarios/infra/chat
(
    steps: [
        WaitReady,
        Wait(1.0),
        Key(KeyT),
        Frames(2),
        Type("hello from the scenario"),
        Frames(3),
        Screenshot("typing"),
        Key(Enter),
        Wait(0.3),
        Key(KeyY),
        Frames(2),
        Type("team only"),
        Frames(2),
        Key(Enter),
        Wait(0.3),
        Key(KeyU),
        Frames(2),
        Type("anyone in my squad?"),
        Frames(2),
        Key(Enter),
        Wait(0.3),
        Key(KeyT),
        Frames(2),
        Type("/players"),
        Frames(2),
        Key(Enter),
        Wait(0.3),
        Key(KeyT),
        Frames(2),
        Type("/login secret"),
        Frames(2),
        Key(Enter),
        Wait(0.3),
        Key(KeyT),
        Frames(2),
        Type("/rotation"),
        Frames(2),
        Key(Enter),
        Wait(1.0),
        Screenshot("chat"),
        // End the round: team 2 runs out of tickets.
        Key(KeyT),
        Frames(2),
        Type("/tickets 0 2"),
        Frames(2),
        Key(Enter),
        Wait(3.0),
        Screenshot("round_over"),
        Wait(15.5),
        Screenshot("switch_1"),
        Wait(1.0),
        Screenshot("switch_2"),
        Wait(1.0),
        Screenshot("switch_3"),
        Wait(1.0),
        Screenshot("switch_4"),
        Wait(1.0),
        Screenshot("switch_5"),
        WaitReady,
        Wait(2.0),
        Screenshot("next_map"),
        Key(Escape),
        Wait(0.3),
        Screenshot("next_map_paused"),
        Key(Escape),
        Wait(0.3),
        // Admin: straight on to the next map of the rotation (back to the test range).
        Key(KeyT),
        Frames(2),
        Type("/next"),
        Frames(2),
        Key(Enter),
        Wait(1.0),
        WaitReady,
        Wait(1.0),
        Screenshot("wrapped"),
        Quit,
    ],
)
