// Tone mapping and bloom on Night Flight: a construction lamp and a fire at night, each
// view with Tony McMapface, AgX and Neutral, without and with bloom.
// client --scenario scenarios/light_tonemap_night.ron --out target/scenarios/light/tonemap/night
(
    level: "night_flight",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        Teleport((-110.0, 21.0, -100.0), 57.0, 0.0),
        Wait(1.5),
        Setting("bloom", "off"),
        Setting("tone_mapping", "tony"),
        Wait(0.5),
        Screenshot("lamp_tony_bloom_off"),
        Setting("tone_mapping", "agx"),
        Wait(0.5),
        Screenshot("lamp_agx_bloom_off"),
        Setting("tone_mapping", "neutral"),
        Wait(0.5),
        Screenshot("lamp_neutral_bloom_off"),
        Setting("bloom", "on"),
        Setting("tone_mapping", "tony"),
        Wait(0.5),
        Screenshot("lamp_tony_bloom_on"),
        Setting("tone_mapping", "agx"),
        Wait(0.5),
        Screenshot("lamp_agx_bloom_on"),
        Setting("tone_mapping", "neutral"),
        Wait(0.5),
        Screenshot("lamp_neutral_bloom_on"),
        Effect("e_dstate_land_fire", (-120.0, 20.5, -108.0), 1, 30.0),
        Effect("e_vexp_fireball_generic", (-122.0, 20.5, -110.0), 1, 30.0),
        Wait(2.0),
        Setting("bloom", "off"),
        Setting("tone_mapping", "tony"),
        Wait(0.5),
        Screenshot("fire_tony_bloom_off"),
        Setting("tone_mapping", "agx"),
        Wait(0.5),
        Screenshot("fire_agx_bloom_off"),
        Setting("tone_mapping", "neutral"),
        Wait(0.5),
        Screenshot("fire_neutral_bloom_off"),
        Setting("bloom", "on"),
        Setting("tone_mapping", "tony"),
        Wait(0.5),
        Screenshot("fire_tony_bloom_on"),
        Setting("tone_mapping", "agx"),
        Wait(0.5),
        Screenshot("fire_agx_bloom_on"),
        Setting("tone_mapping", "neutral"),
        Wait(0.5),
        Screenshot("fire_neutral_bloom_on"),
        Setting("bloom", "off"),
        Setting("tone_mapping", "tony"),
        Wait(1.0),
        Measure("bloom_off", 4.0),
        Setting("bloom", "on"),
        Wait(1.0),
        Measure("bloom_on", 4.0),
        Quit,
    ],
)
