// The level page's map preview: Karkand's conquest layouts (flags with names and first
// owners' flags, main bases, vehicle spawns), the teams' flags next to the team buttons, and
// another level.
// client --scenario scenarios/menu_preview.ron --out target/scenarios/menu_preview
(
    menu: true,
    steps: [
        WaitReady,
        Screenshot("home"),
        Click("menu:play"),
        Wait(0.3),
        Click("level:strike_at_karkand"),
        Wait(0.3),
        Click("layout:gpm_cq:64"),
        Wait(0.3),
        WaitReady,
        Screenshot("karkand_64"),
        Click("layout:gpm_cq:16"),
        Wait(0.3),
        WaitReady,
        Screenshot("karkand_16"),
        Click("level:dalian_plant"),
        Wait(0.3),
        Click("layout:gpm_cq:64"),
        Wait(0.3),
        WaitReady,
        Screenshot("dalian_64"),
        Click("level:road_to_jalalabad"),
        Wait(0.3),
        WaitReady,
        Screenshot("jalalabad"),
        Quit,
    ],
)
