// Flag and vehicle icons in game: the ticket bar and flag pills with the teams' flags, the
// minimap and the big map with flag icons and vehicles (grey empty ones at the US base,
// ours in blue with the turret line once we sit in the M1A2 and turn the turret), the
// scoreboard's team flags, the deploy screen's markers and the commander screen.
// client --scenario scenarios/map_icons.ron --out target/scenarios/map_icons
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 12,
    steps: [
        WaitReady,
        Wait(1.5),
        Screenshot("hud"),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("bigmap"),
        ReleaseKey(KeyM),
        HoldKey(Tab),
        Wait(0.3),
        Screenshot("scoreboard"),
        ReleaseKey(Tab),
        Key(Enter),
        Wait(0.5),
        Screenshot("deploy"),
        Key(Enter),
        Wait(0.3),
        NearVehicle("ustnk_m1a2"),
        Wait(1.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleLook(70.0, 0.0),
        Wait(2.5),
        Screenshot("tank_minimap"),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("tank_bigmap"),
        ReleaseKey(KeyM),
        Commander(Apply),
        Wait(1.0),
        Key(CapsLock),
        Wait(0.8),
        Screenshot("commander"),
        Key(CapsLock),
        Quit,
    ],
)
