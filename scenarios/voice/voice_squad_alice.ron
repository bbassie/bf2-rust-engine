// Voice chat over a dedicated server, the squad leader's side (pairs with voice_squad_bob.ron).
// Co-op puts both humans on one team. Alice leads squad 1, Bob joins it: Bob hears Alice on
// the squad channel and Alice hears Bob; Alice's command channel reaches nobody (no
// commander, no other leader), so Bob never hears it. Then Alice mutes Bob on the scoreboard
// and no longer hears him. Both feed a tone instead of a microphone.
// target/debug/deps/server.exe --level test_range --mode gpm_coop --bots 0 --port 30100 --rcon-port 0
// BF2_VOICE_TEST_INPUT=tone:440 target/debug/deps/client.exe --connect 127.0.0.1 --port 30100 --name Alice --scenario scenarios/voice/voice_squad_alice.ron
// BF2_VOICE_TEST_INPUT=tone:660 target/debug/deps/client.exe --connect 127.0.0.1 --port 30100 --name Bob --scenario scenarios/voice/voice_squad_bob.ron
(
    steps: [
        WaitReady,
        ForbidLog("ERROR "),
        Squad(Create),
        ExpectLog("voice: squad channel reaches Bob", 60.0),
        Wait(1.0),
        // Squad voice: Bob hears it.
        HoldKey(KeyB),
        Wait(0.6),
        Screenshot("talking"),
        Wait(1.4),
        ReleaseKey(KeyB),
        ExpectLog("voice: stopped talking on squad", 3.0),
        // Bob answers on the squad channel.
        ExpectLog("voice: hearing Bob on squad", 30.0),
        Wait(0.5),
        Screenshot("hearing_bob"),
        ExpectLog("voice: Bob stopped on squad", 10.0),
        // The command channel: squad leaders and the commander only; Bob is neither.
        Wait(1.0),
        HoldKey(KeyH),
        Wait(1.5),
        ReleaseKey(KeyH),
        ExpectLog("voice: stopped talking on command", 3.0),
        // Mute Bob on the scoreboard: his next words don't reach us.
        HoldKey(Tab),
        Wait(0.3),
        Click("voice:mute:Bob"),
        Wait(0.3),
        Screenshot("scoreboard_muted"),
        ReleaseKey(Tab),
        ExpectLog("voice: Bob muted", 2.0),
        ForbidLog("voice: hearing Bob"),
        Wait(14.0),
        Quit,
    ],
)
