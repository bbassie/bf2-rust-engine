// Water animation stability: bursts of screenshots 50 ms apart over the Karkand river, to
// compare frame to frame (a surface that pulses as a whole changes its mean brightness).
// client --scenario scenarios/water_flicker.ron --out target/scenarios/water_flicker
(
    level: "strike_at_karkand",
    bots: 0,
    spectate: true,
    steps: [
        WaitReady,
        Camera((0.0, 152.0, 80.0), 0.0, -18.0),
        Wait(2.0),
        Screenshot("river_0"),
        Wait(0.05),
        Screenshot("river_1"),
        Wait(0.05),
        Screenshot("river_2"),
        Wait(0.05),
        Screenshot("river_3"),
        Wait(0.05),
        Screenshot("river_4"),
        Wait(0.05),
        Screenshot("river_5"),
        Wait(0.05),
        Screenshot("river_6"),
        Wait(0.05),
        Screenshot("river_7"),
        Camera((-4.0, 149.5, 64.0), 0.0, -40.0),
        Wait(1.0),
        Screenshot("close_0"),
        Wait(0.05),
        Screenshot("close_1"),
        Wait(0.05),
        Screenshot("close_2"),
        Wait(0.05),
        Screenshot("close_3"),
        Wait(0.05),
        Screenshot("close_4"),
        Wait(0.05),
        Screenshot("close_5"),
        Quit,
    ],
)
