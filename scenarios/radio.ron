// The commo rose and spotting, checked through the log and screenshots: the rose open (Q
// held), radio messages as the commo rose sends them (voice-over and chat line), an enemy
// summoned in front of us and spotted (red marker on the HUD, the minimap and the map), a
// reload call-out, and our soldier going down (the scream, over the radio too).
// RUST_LOG=info,audio=debug target/debug/deps/client.exe --scenario scenarios/radio.ron --out target/scenarios/radio
(
    level: "strike_at_karkand",
    bots: 8,
    team: 2,
    steps: [
        WaitReady,
        Teleport((-150.0, 162.0, 260.0), 180.0, 0.0),
        Wait(1.0),
        HoldKey(KeyQ),
        Wait(0.3),
        Screenshot("rose"),
        ReleaseKey(KeyQ),
        Log("reload"),
        Hold([Fire]),
        Wait(0.5),
        Release([Fire]),
        Hold([Reload]),
        Wait(0.3),
        Release([Reload]),
        Wait(3.0),
        Radio(NeedMedic),
        Wait(2.5),
        Radio(GoGoGo),
        Wait(2.5),
        Log("spot"),
        SummonEnemy(25.0),
        Wait(0.5),
        Radio(Spotted),
        Wait(1.0),
        Screenshot("spotted"),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("spotted_map"),
        ReleaseKey(KeyM),
        Log("nothing to spot"),
        Look(0.0, 60.0),
        Wait(2.5),
        Radio(Spotted),
        Wait(1.0),
        Log("man down"),
        Down,
        Wait(2.0),
        Screenshot("down"),
        Quit,
    ],
)
