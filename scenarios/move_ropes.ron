// Special Forces ropes on Warlord (SAS): a grappling hook thrown onto the office building's
// roof and climbed, then (as spec ops) a zipline from that roof down to the street.
// client --scenario scenarios/move_ropes.ron --out target/scenarios/move/ropes
(
    level: "warlord",
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        ThirdPerson(true),
        // Assault (the first kit here): the grappling hook is its 9th weapon. 15 m south of
        // the office building (its roof is 11 m up), throwing high over its edge.
        Teleport((99.0, 96.0, 190.0), 0.0, 50.0),
        Wait(2.0),
        Weapon(8),
        Wait(1.5),
        Screenshot("hook_ready"),
        Hold([Fire]),
        Wait(0.3),
        Release([Fire]),
        Wait(3.0),
        Look(0.0, 15.0),
        Wait(0.3),
        Screenshot("rope"),
        Move(0.0, 1.0),
        Trace("to_rope", 5.0),
        Screenshot("climbing"),
        Trace("climb", 2.0),
        Screenshot("on_rope"),
        Trace("climb_top", 4.0),
        Screenshot("roof"),
        Move(0.0, 0.0),

        // Spec ops: the zipline crossbow is its 9th weapon too.
        Kill,
        Wait(1.0),
        Click("kit:0"),
        WaitReady,
        Teleport((99.0, 106.0, 165.4), 180.0, -12.0),
        Wait(1.5),
        Weapon(8),
        Wait(2.0),
        Screenshot("crossbow"),
        Hold([Fire]),
        Wait(0.2),
        Release([Fire]),
        Wait(1.0),
        Look(180.0, 0.0),
        Wait(0.3),
        Screenshot("zipline"),
        Move(0.0, 1.0),
        Trace("to_wire", 2.5),
        Screenshot("riding"),
        Trace("ride", 8.0),
        Screenshot("landed"),
        Move(0.0, 0.0),
        Quit,
    ],
)
