// Lighting check: Night Flight (night): the airport terminal, a hangar, a quad bike.
// Views with the sun (or moon) behind and in front of the camera, the sky, our soldier in
// third person lit from the side, a building interior and a vehicle close up.
// client --scenario scenarios/light_night_flight.ron --out target/scenarios/light/<before|after>/night_flight
(
    level: "night_flight",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        Screenshot("spawn"),
        // Sun behind the camera: sunlit faces.
        Teleport((-35.7, 19.6, -138.2), -49.0, -4.0),
        Wait(1.5),
        Screenshot("sunlit"),
        // Facing the sun: shaded faces against the bright sky.
        Look(131.0, -4.0),
        Wait(0.5),
        Screenshot("against_sun"),
        Look(41.0, 18.0),
        Wait(0.5),
        Screenshot("sky"),
        // Our soldier, lit from the side.
        ThirdPerson(true),
        Look(41.0, -8.0),
        Wait(2.5),
        Screenshot("soldier"),
        ThirdPerson(false),
        Teleport((-54.0, 19.6, -306.0), 0.0, -2.0),
        Wait(1.5),
        Screenshot("interior"),
        NearVehicle("xpak_atv"),
        ThirdPerson(true),
        Wait(2.5),
        Screenshot("vehicle"),
        Quit,
    ],
)
