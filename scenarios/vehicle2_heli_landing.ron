// Landing the Z-10 on Wake Island: spin up, climb 20 m, hover, then hold the collective down
// until it sits on its skids, and let go on the ground. The report traces the descent, the
// touchdown speed and whether it bounces, slides or tips.
// client --scenario scenarios/vehicle2_heli_landing.ron --out target/scenarios/vehicle2/heli_landing
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("ahe_z10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        VehicleTrace("spin up", 6.0),
        Move(0.0, 1.0),
        VehicleTrace("climb", 3.0),
        Move(0.0, 0.0),
        VehicleTrace("hover", 3.0),
        Move(0.0, -1.0),
        VehicleTrace("descend", 6.0),
        Screenshot("01_touchdown"),
        Move(0.0, 0.0),
        VehicleTrace("on the ground", 4.0),
        Screenshot("02_landed"),
        Quit,
    ],
)
