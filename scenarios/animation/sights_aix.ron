// Weapon sights, AIX 2 (Damocles, UN, day), standing on a road: AIX's zoom models are a
// blurred scope frame on a transparent quad around the world, sometimes with a reticle quad:
// P90 (red dot as HUD, AimPoint), Magpul (EOTech reticle in the model), STG-58 (low power,
// no model), SIG 552 (scope), Steyr AUG (scope). Each at the hip and aimed; then prone on the
// road: the road (a transparent decal) must not draw over the scope frame, the ground never
// cut into the weapon. Night vision isn't there: no goggles in AIX's kits, and it is day.
// client --scenario scenarios/animation/sights_aix.ron --out target/scenarios/sights/aix
(
    level: "aix2_aix_damocles",
    bots: 0,
    team: 2,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        // The first spawn (so later expectations wait for the respawns).
        ExpectLog("spawned as", 30.0),
        // P90: red dot.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:0"),
        ExpectLog("spawned as un_specops", 30.0),
        Wait(0.5),
        Teleport((-96.6, 45.0, 466.3), 125.0, -3.0),
        Weapon(7),
        Wait(2.5),
        Screenshot("p90_hip"),
        Hold([Aim]),
        ExpectLog("zoom sight of aix_p90: 1 pictures", 3.0),
        Wait(0.6),
        Screenshot("p90_aim"),
        Release([Aim]),
        Wait(0.5),
        Key(KeyL),
        ExpectLog("night vision not available", 3.0),
        Wait(0.3),
        Screenshot("nv_unavailable"),
        // Prone on the road, aimed down the road and at the road right in front.
        Key(KeyZ),
        Wait(2.0),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("p90_prone_aim"),
        Look(125.0, -25.0),
        Wait(0.3),
        Screenshot("p90_prone_aim_down"),
        Release([Aim]),
        Wait(0.5),
        Screenshot("p90_prone_hip_down"),
        // Magpul: EOTech.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:2"),
        ExpectLog("spawned as un_assault", 30.0),
        Wait(0.5),
        Teleport((-96.6, 45.0, 466.3), 125.0, -3.0),
        Weapon(0),
        Wait(2.5),
        Screenshot("magpul_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("magpul_aim"),
        Release([Aim]),
        // STG-58.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:3"),
        ExpectLog("spawned as un_support", 30.0),
        Wait(0.5),
        Teleport((-96.6, 45.0, 466.3), 125.0, -3.0),
        Weapon(5),
        Wait(2.5),
        Screenshot("stg58_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("stg58_aim"),
        Release([Aim]),
        // SIG 552 SpecOps: scope.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:4"),
        ExpectLog("spawned as un_engineer", 30.0),
        Wait(0.5),
        Teleport((-96.6, 45.0, 466.3), 125.0, -3.0),
        Weapon(7),
        Wait(2.5),
        Screenshot("sig552_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("sig552_aim"),
        Release([Aim]),
        // Steyr AUG: scope, prone on the road.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:5"),
        ExpectLog("spawned as un_medic", 30.0),
        Wait(0.5),
        Teleport((-96.6, 45.0, 466.3), 125.0, -3.0),
        Weapon(6),
        Wait(2.5),
        Screenshot("aug_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("aug_aim"),
        Release([Aim]),
        Key(KeyZ),
        Wait(2.0),
        Look(125.0, -20.0),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("aug_prone_aim_down"),
        Release([Aim]),
        Quit,
    ],
)
