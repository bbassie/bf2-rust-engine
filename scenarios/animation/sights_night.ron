// Weapon sights and night vision at night (Special Forces' Leviathan, Navy SEALs): the SCAR-H's
// red dot (HUD, as bright as by day), the M24's scope and the crossbow's, each at the hip and
// aimed; night vision (L) off and on, the view model included in its picture.
// client --scenario scenarios/animation/sights_night.ron --out target/scenarios/sights/night
(
    level: "leviathan",
    bots: 0,
    team: 2,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        // The first spawn (so later expectations wait for the respawns).
        ExpectLog("spawned as", 30.0),
        // SCAR-H: red dot.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:2"),
        ExpectLog("spawned as seal_assault", 30.0),
        Wait(2.5),
        Weapon(0),
        Wait(2.5),
        Screenshot("scar_hip"),
        Hold([Aim]),
        ExpectLog("zoom sight of usrif_fnscarh: 1 pictures", 3.0),
        Wait(0.6),
        Screenshot("scar_aim"),
        Release([Aim]),
        Wait(0.5),
        // Night vision on, hip and aimed, then off.
        Key(KeyL),
        ExpectLog("night vision on", 3.0),
        Wait(0.6),
        Screenshot("nv_on_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("nv_on_aim"),
        Release([Aim]),
        Key(KeyL),
        ExpectLog("night vision off", 3.0),
        Wait(0.6),
        Screenshot("nv_off"),
        // Sniper: M24 and crossbow.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:1"),
        ExpectLog("spawned as seal_sniper", 30.0),
        Wait(2.5),
        Weapon(5),
        Wait(2.5),
        Screenshot("m24_hip"),
        Hold([Aim]),
        Wait(0.9),
        Screenshot("m24_aim"),
        Release([Aim]),
        Weapon(8),
        Wait(2.5),
        Screenshot("crossbow_hip"),
        Hold([Aim]),
        Wait(0.9),
        Screenshot("crossbow_aim"),
        Release([Aim]),
        Quit,
    ],
)
