// Weapon sights and night vision on an AIX 2 level at night (Damocles' night version, UN):
// AIX's kits carry no goggles, but at night everyone has night vision. P90 (red dot as HUD)
// and Steyr AUG (scope lens and reticle) at the hip and aimed, night vision off and on.
// BF2_LIGHT=night=1 client --scenario scenarios/animation/sights_aix_night.ron --out target/scenarios/sights/aix_night
(
    level: "aix2_aix_damocles",
    bots: 0,
    team: 2,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        // Fails without BF2_LIGHT=night=1: Damocles is a day level.
        // The first spawn (so later expectations wait for the respawns).
        ExpectLog("spawned as", 30.0),
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:0"),
        ExpectLog("spawned as un_specops", 30.0),
        Wait(0.5),
        Teleport((-96.6, 45.0, 466.3), 125.0, -3.0),
        Weapon(7),
        Wait(2.5),
        Screenshot("p90_hip"),
        Hold([Aim]),
        ExpectLog("zoom sight of aix_p90: 1 pictures", 3.0),
        Wait(0.6),
        Screenshot("p90_aim"),
        Release([Aim]),
        Wait(0.3),
        Key(KeyL),
        ExpectLog("night vision on", 3.0),
        Wait(0.6),
        Screenshot("nv_on_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("nv_on_aim"),
        Release([Aim]),
        Key(KeyL),
        ExpectLog("night vision off", 3.0),
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:5"),
        ExpectLog("spawned as un_medic", 30.0),
        Wait(0.5),
        Teleport((-96.6, 45.0, 466.3), 125.0, -3.0),
        Weapon(6),
        Wait(2.5),
        Screenshot("aug_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("aug_aim"),
        Release([Aim]),
        Quit,
    ],
)
