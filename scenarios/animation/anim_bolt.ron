// Bolt-action rifle (US sniper kit's M24): a zoomed shot drops out of the scope, the bolt
// cycles unzoomed and the scope comes back with aim still held.
// client --team 2 --scenario scenarios/animation/anim_bolt.ron --out target/scenarios/anim/bolt
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:1"),
        WaitSpawned(20.0),
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Weapon(5),
        Wait(2.5),
        Hold([Aim]),
        Wait(1.0),
        Screenshot("0_zoomed"),
        Hold([Fire]),
        Frames(2),
        Release([Fire]),
        Wait(0.05),
        Screenshot("1_shot"),
        Wait(0.25),
        Screenshot("2_bolt_start"),
        Wait(0.5),
        Screenshot("3_bolt"),
        Wait(0.5),
        Screenshot("4_bolt_end"),
        Wait(0.6),
        Screenshot("5_zoom_back"),
        Wait(0.6),
        Screenshot("6_zoomed_again"),
        Release([Aim]),
        Wait(0.5),
        // Third person: fire and reload on the soldier.
        ThirdPerson(true),
        Wait(0.5),
        Screenshot("7_third_person"),
        Hold([Fire]),
        Frames(2),
        Release([Fire]),
        Wait(0.1),
        Screenshot("8_third_person_fire"),
        Quit,
    ],
)
