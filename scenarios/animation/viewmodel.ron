// First-person view model: idle, zoomed, firing, reloading, third person.
// client --scenario scenarios/animation/viewmodel.ron
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        // The square, looking north along the street.
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Wait(1.5),
        Screenshot("idle"),
        Hold([Aim]),
        Wait(0.6),
        Screenshot("zoomed"),
        Hold([Fire]),
        Wait(0.35),
        Screenshot("zoomed_fire"),
        Release([Fire, Aim]),
        Hold([Reload]),
        Wait(1.0),
        Screenshot("reload"),
        Release([Reload]),
        Wait(3.0),
        ThirdPerson(true),
        Wait(0.3),
        Screenshot("third_person"),
        Quit,
    ],
)
