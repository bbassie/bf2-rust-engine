// Weapon sights, vanilla (Strike at Karkand, MEC, day): iron sights (AK-101), the red dot
// (AK-74U: BF2 draws its AimPoint dot as HUD while zoomed), a scope (SVD), each at the hip
// and aimed; then the view model against a wall (standing, crouched, prone, zoomed) and prone
// looking down at the ground: the world must never cut into the weapon.
// client --scenario scenarios/animation/sights_vanilla.ron --out target/scenarios/sights/vanilla
(
    level: "strike_at_karkand",
    bots: 0,
    team: 1,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        // Iron sights: the first spawn carries the assault kit.
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Weapon(0),
        Wait(2.0),
        Screenshot("iron_hip"),
        Hold([Aim]),
        Wait(0.8),
        Screenshot("iron_aim"),
        Release([Aim]),
        // Red dot: special forces' AK-74U.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:0"),
        ExpectLog("spawned as mec_specops", 30.0),
        Wait(0.5),
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Weapon(4),
        Wait(2.5),
        Screenshot("reddot_hip"),
        Hold([Aim]),
        ExpectLog("zoom sight of rurrif_ak74u: 1 pictures", 3.0),
        Wait(0.6),
        Screenshot("reddot_aim"),
        Release([Aim]),
        // Scope: the sniper's SVD.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:1"),
        ExpectLog("spawned as mec_sniper", 30.0),
        Wait(0.5),
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Weapon(4),
        Wait(2.5),
        Screenshot("scope_hip"),
        Hold([Aim]),
        Wait(0.9),
        Screenshot("scope_aim"),
        Release([Aim]),
        // Up against the low wall at the far side of the square.
        Move(0.0, 1.0),
        Wait(6.0),
        Move(0.0, 0.0),
        Wait(1.0),
        Screenshot("wall_stand"),
        Look(20.0, -25.0),
        Wait(0.3),
        Screenshot("wall_stand_down"),
        Hold([Crouch]),
        Wait(1.2),
        Screenshot("wall_crouch"),
        Hold([Aim]),
        Wait(0.9),
        Screenshot("wall_crouch_aim"),
        Release([Aim, Crouch]),
        Wait(1.0),
        Key(KeyZ),
        Wait(2.0),
        LogStance("at the wall"),
        ExpectLog("at the wall: stance Prone", 3.0),
        Look(20.0, 0.0),
        Wait(0.3),
        Screenshot("wall_prone"),
        Look(20.0, -30.0),
        Wait(0.3),
        Screenshot("wall_prone_down"),
        Hold([Aim]),
        Wait(0.9),
        Screenshot("wall_prone_aim"),
        Release([Aim]),
        // Prone, turned from the wall, looking down at the ground right in front.
        Look(200.0, -40.0),
        Wait(0.5),
        Screenshot("prone_ground"),
        Weapon(1),
        Wait(2.0),
        Screenshot("prone_ground_pistol"),
        Quit,
    ],
)
