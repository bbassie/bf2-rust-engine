// Zoom on weapons without a scope: assault rifle (zoom model with blurred rear sight) and
// pistol (no zoom model, unchanged). The first spawn uses the Assault kit.
// client --scenario scenarios/animation/scope_iron.ron --out target/scenarios/scope/iron
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Weapon(0),
        Wait(2.0),
        Screenshot("rifle_hip"),
        Hold([Aim]),
        Wait(0.05),
        Screenshot("rifle_zooming"),
        Wait(0.1),
        Screenshot("rifle_zooming_2"),
        Wait(0.07),
        Screenshot("rifle_zooming_3"),
        Wait(0.4),
        Screenshot("rifle_zoom"),
        Hold([Fire]),
        Wait(0.2),
        Screenshot("rifle_zoom_fire"),
        Release([Fire]),
        Move(0.0, 1.0),
        Wait(0.5),
        Screenshot("rifle_zoom_walk"),
        Move(0.0, 0.0),
        Release([Aim]),
        Wait(0.1),
        Screenshot("rifle_unzoomed"),
        Weapon(2),
        Wait(2.0),
        Hold([Aim]),
        Wait(0.6),
        Screenshot("pistol_zoom"),
        Release([Aim]),
        Quit,
    ],
)
