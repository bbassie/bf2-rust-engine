// Weapon scopes: sniper rifle and Special Forces rifle, hip and zoomed.
// client --scenario scenarios/animation/scope_sniper.ron --out target/scenarios/scope/sniper
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        // Sniper kit.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:1"),
        WaitSpawned(20.0),
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Weapon(4),
        Wait(2.5),
        Screenshot("sniper_hip"),
        Hold([Aim]),
        Wait(0.1),
        Screenshot("sniper_zooming"),
        Wait(0.8),
        Screenshot("sniper_zoom"),
        Hold([Fire]),
        Wait(0.1),
        Screenshot("sniper_zoom_fire"),
        Release([Fire]),
        Wait(0.6),
        Move(0.0, 1.0),
        Wait(0.5),
        Screenshot("sniper_zoom_walk"),
        Move(0.0, 0.0),
        // Reloading leaves the scope.
        Hold([Reload]),
        Wait(0.5),
        Screenshot("sniper_zoom_reload"),
        Release([Reload, Aim]),
        Weapon(5),
        Wait(2.5),
        Hold([Aim]),
        Wait(0.9),
        Screenshot("sniper_zoom_w5"),
        Release([Aim]),
        // Special Forces kit.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:0"),
        WaitSpawned(20.0),
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Weapon(4),
        Wait(2.5),
        Screenshot("specops_hip"),
        Hold([Aim]),
        Wait(0.9),
        Screenshot("specops_zoom"),
        Release([Aim]),
        Quit,
    ],
)
