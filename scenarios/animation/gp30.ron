// MEC GP-30 underbarrel grenade launcher (Assault kit's secondary fire): the same sequence as
// m203.ron, for comparison (this one worked correctly before the fix).
// client --scenario scenarios/animation/gp30.ron --out target/scenarios/m203_vs_gp30/gp30
(
    level: "strike_at_karkand",
    bots: 0,
    team: 1,
    steps: [
        WaitReady,
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:2"),
        WaitSpawned(20.0),
        Teleport((-184.0, 157.0, -85.0), 180.0, 0.0),
        Wait(1.0),
        Screenshot("00_1p_rifle"),
        // Switch to the launcher: the deploy animation, first person.
        Weapon(1),
        Frames(4),
        Screenshot("01_1p_switch"),
        Wait(0.5),
        Screenshot("02_1p_ready"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Screenshot("03_1p_fire"),
        Wait(1.5),
        Hold([Reload]),
        Wait(0.1),
        Release([Reload]),
        Wait(0.5),
        Screenshot("04_1p_reload"),
        Wait(4.0),
        Screenshot("05_1p_reload_done"),
        // Back to the rifle, then the same sequence in third person.
        Weapon(0),
        Wait(2.0),
        ThirdPerson(true),
        Wait(0.5),
        Screenshot("06_3p_rifle"),
        Weapon(1),
        Frames(4),
        Screenshot("07_3p_switch"),
        Wait(0.5),
        Screenshot("08_3p_ready"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Screenshot("09_3p_fire"),
        Wait(1.5),
        Hold([Reload]),
        Wait(0.1),
        Release([Reload]),
        Wait(0.5),
        Screenshot("10_3p_reload"),
        Wait(4.0),
        Screenshot("11_3p_reload_done"),
        Quit,
    ],
)
