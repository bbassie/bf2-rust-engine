// Particle effects on Strike at Karkand: our muzzle flash and bullet impacts, a grenade
// explosion, a rocket explosion, smoke, dust and blood.
// client --scenario scenarios/effects_visual.ron --out target/scenarios/effects/visual
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        // The square, looking north along the street.
        Teleport((-184.0, 157.0, -85.0), 20.0, -4.0),
        Wait(1.5),
        Screenshot("idle"),
        // Firing: muzzle flash, impacts down the street.
        Hold([Fire]),
        Wait(0.05),
        Screenshot("fire_1"),
        Wait(0.12),
        Screenshot("fire_2"),
        Release([Fire]),
        Look(20.0, -25.0),
        Hold([Fire]),
        Wait(0.3),
        Screenshot("impacts_ground"),
        Release([Fire]),
        Look(20.0, -4.0),
        Wait(1.0),
        // Explosions 15 m ahead.
        Effect("e_exp_grenade", (-189.0, 156.3, -99.0), 1, 0.0),
        Wait(0.05),
        Screenshot("grenade_1"),
        Wait(0.25),
        Screenshot("grenade_2"),
        Wait(1.0),
        Screenshot("grenade_3"),
        Wait(2.0),
        Effect("e_exp_medium", (-189.0, 156.3, -99.0), 1, 0.0),
        Wait(0.1),
        Screenshot("rocket_1"),
        Wait(0.6),
        Screenshot("rocket_2"),
        Wait(3.0),
        // Smoke that keeps coming for 30 s.
        Effect("e_hgr_smokegrenade", (-189.0, 156.3, -99.0), 1, 30.0),
        Wait(1.0),
        Screenshot("smoke_1"),
        Wait(4.0),
        Screenshot("smoke_2"),
        Wait(10.0),
        Screenshot("smoke_3"),
        Quit,
    ],
)
