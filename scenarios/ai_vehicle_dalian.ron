// Bots flying on Dalian Plant (64): attack helicopters circle their objective and fire, transport
// helicopters fly squads from the carrier and the airfield, jets take off and patrol, boats
// leave the carrier. The camera chases a bot-flown helicopter, jet or boat for each screenshot.
// client --scenario scenarios/ai_vehicle_dalian.ron
(
    level: "dalian_plant",
    size: 64,
    bots: 32,
    spectate: true,
    steps: [
        WaitReady,
        Camera((740.0, 200.0, 120.0), 170.0, -20.0),
        Wait(15.0),
        Screenshot("carrier_15s"),
        ChaseDriven("helicopter", 25.0, 8.0),
        Screenshot("heli_1"),
        Wait(15.0),
        ChaseDriven("helicopter", 25.0, 8.0),
        Screenshot("heli_2"),
        ChaseDriven("sea", 18.0, 6.0),
        Screenshot("boat_1"),
        Wait(15.0),
        ChaseDriven("air", 35.0, 8.0),
        Screenshot("jet_1"),
        ChaseDriven("helicopter", 25.0, 8.0),
        Screenshot("heli_3"),
        Wait(20.0),
        ChaseDriven("helicopter", 30.0, 10.0),
        Screenshot("heli_4"),
        ChaseDriven("sea", 18.0, 6.0),
        Screenshot("boat_2"),
        ChaseDriven("land", 16.0, 7.0),
        Screenshot("land_1"),
        LogVehicles("after 70 s"),
        Wait(30.0),
        ChaseDriven("helicopter", 30.0, 10.0),
        Screenshot("heli_5"),
        ChaseDriven("air", 40.0, 10.0),
        Screenshot("jet_2"),
        Quit,
    ],
)
