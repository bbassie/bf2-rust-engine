// Soldier hit zones (BF2's per-bone capsules posed by stance) drawn over the model: run with
// BF2_SHOW_HITZONES=1. Our soldier in third person standing, crouching and prone, from the
// side and the front; the log shows headshots and limb hits from the rifle.
// BF2_SHOW_HITZONES=1 client --scenario scenarios/combat/hitzones.ron --out target/scenarios/hitzones
(
    level: "strike_at_karkand",
    bots: 0,
    third_person: true,
    steps: [
        WaitReady,
        Teleport((-184.0, 157.0, -85.0), 90.0, -10.0),
        Wait(1.5),
        Screenshot("standing_side"),
        Look(0.0, -10.0),
        Wait(0.5),
        Screenshot("standing_back"),
        Look(90.0, -10.0),
        Hold([Crouch]),
        Wait(1.5),
        Screenshot("crouching_side"),
        Release([Crouch]),
        Hold([Prone]),
        Wait(2.0),
        Screenshot("prone_side"),
        Look(180.0, -15.0),
        Wait(0.5),
        Screenshot("prone_front"),
        Quit,
    ],
)
