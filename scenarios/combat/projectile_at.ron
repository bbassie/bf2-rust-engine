// Anti-tank kit on Strike at Karkand: the Eryx is wire guided (BF2 `TSWireGuided`): it flies
// towards whatever the shooter aims at while he holds the launcher. A straight shot, one
// steered up after launch, and one that loses its guidance when the shooter
// switches weapons. Compare the `went off at` positions in the log (with
// RUST_LOG=info,game_server::combat=debug it logs the missile's path too).
// client --scenario scenarios/combat/projectile_at.ron --out target/scenarios/projectile/at
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        Wait(1.0),
        Click("kit:6"),
        Wait(16.0),
        Teleport((-184.0, 157.0, -85.0), 180.0, 1.0),
        Weapon(0),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.35),
        Screenshot("eryx_straight"),
        Wait(2.0),
        Hold([Reload]),
        Wait(0.1),
        Release([Reload]),
        Wait(5.0),
        // Steered: the aim goes up 6 degrees just after launch, onto the upper floors.
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Look(180.0, 7.0),
        Wait(0.3),
        Screenshot("eryx_steered"),
        Wait(2.0),
        Hold([Reload]),
        Wait(0.1),
        Release([Reload]),
        Wait(5.0),
        Look(180.0, 1.0),
        Wait(0.2),
        // Switching to the pistol cuts the wire: it keeps flying straight.
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.2),
        Weapon(1),
        Look(180.0, 7.0),
        Wait(2.0),
        Quit,
    ],
)
