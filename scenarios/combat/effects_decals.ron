// Marks on surfaces on Strike at Karkand: bullet holes in wooden crates and a concrete
// barrier, a rifle grenade's scorch mark on the square.
// client --scenario scenarios/combat/effects_decals.ron --out target/scenarios/effects/decals
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        // Wooden crates (woodencrate_group3) 3.7 m to the north, over the planter's rim.
        Teleport((-182.9, 157.0, -93.3), 0.0, 1.0),
        Wait(1.0),
        Hold([Fire]),
        Wait(0.4),
        Release([Fire]),
        Look(0.0, 1.0),
        Wait(1.0),
        Screenshot("holes_wood"),
        // The concrete barrier to the right.
        Look(-35.0, -3.0),
        Wait(0.3),
        Hold([Fire]),
        Wait(0.4),
        Release([Fire]),
        Look(-35.0, -3.0),
        Wait(1.0),
        Screenshot("holes_concrete"),
        // A rifle grenade onto the square to the south: it lands about 25 m away. Walk up.
        Weapon(1),
        Look(180.0, -10.0),
        Wait(2.0),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(3.0),
        Teleport((-182.8, 157.0, -73.0), 180.0, -35.0),
        Wait(0.5),
        Screenshot("scorch"),
        Quit,
    ],
)
