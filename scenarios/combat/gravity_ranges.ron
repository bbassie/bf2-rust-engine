// Ranges under BF2's world gravity (14.73 m/s², times each object's gravityModifier; see
// `game_shared::physics::WORLD_GRAVITY`), on Karkand's straight, flat southern road: a hand
// grenade thrown at 30 and 45 degrees, the M203 fired at 10 degrees, the M1A2's gun
// (150 m/s, modifier 0.4) fired level and 2 degrees up along the road (where the shell comes
// down gives its drop), then the Humvee (modifier 1.5): its ride height at rest and drives
// off a 4 m ledge at 15 m/s and a 1.5 m one at 12 m/s. The server logs throws and shots (`throws ... from`, `fires ...
// from`), first touchdowns and where things went off; VehicleInfo/VehicleTrace go to the
// report.
// client --scenario scenarios/combat/gravity_ranges.ron --out target/scenarios/combat/gravity_ranges
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 0,
    // This stretch of the southern road sits outside size 64's combat area polygon (it's a
    // firing range for arcs and drops, not a check of staying in bounds); the out-of-bounds
    // countdown would otherwise kill the soldier mid-sequence.
    out_of_bounds: Some(false),
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:0"),
        WaitSpawned(20.0),
        // Hand grenade (25 m/s), 30 degrees up along the road.
        Teleport((-200.6, 158.0, -505.0), 180.0, 30.0),
        Weapon(1),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        ExpectLog("throws ushgr_m67", 2.0),
        ExpectLog("ushgr_m67 went off", 6.0),
        Wait(3.0),
        // 45 degrees.
        Teleport((-200.6, 158.0, -505.0), 180.0, 45.0),
        Weapon(1),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        ExpectLog("throws ushgr_m67", 2.0),
        ExpectLog("ushgr_m67 went off", 6.0),
        Wait(3.0),
        // The M203, 10 degrees up.
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:2"),
        WaitSpawned(20.0),
        Teleport((-200.6, 158.0, -505.0), 180.0, 10.0),
        Weapon(1),
        Wait(2.0),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        ExpectLog("fires usrgl_m203", 2.0),
        ExpectLog("usrgl_m203 went off", 6.0),
        Wait(1.0),
        // The M1A2's gun, level and 2 degrees up.
        NearVehicle("ustnk_m1a2"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        WaitInVehicle(3.0),
        PlaceVehicle((-200.6, 157.5, -505.0), 180.0, 0.0),
        Wait(2.0),
        VehicleLook(0.0, 0.0),
        Wait(2.5),
        VehicleInfo("tank level"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        ExpectLog("ustnk_m1a2_barrel went off", 5.0),
        Wait(0.5),
        Screenshot("tank_level"),
        VehicleLook(0.0, 2.0),
        Wait(7.0),
        VehicleInfo("tank 2 degrees"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        ExpectLog("ustnk_m1a2_barrel went off", 6.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        // The Humvee at rest, and off a 4 m ledge at 15 m/s.
        NearVehicle("usjep_hmmwv"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        WaitInVehicle(3.0),
        ThirdPerson(true),
        PlaceVehicle((-200.6, 157.5, -440.0), 180.0, 0.0),
        Wait(3.0),
        VehicleInfo("hmmwv at rest"),
        Screenshot("hmmwv_rest"),
        PlaceVehicle((-200.6, 160.8, -440.0), 180.0, 15.0),
        VehicleTrace("hmmwv off a 4 m ledge", 3.0),
        VehicleInfo("hmmwv landed"),
        Screenshot("hmmwv_landed"),
        PlaceVehicle((-200.6, 158.3, -380.0), 180.0, 12.0),
        VehicleTrace("hmmwv off a 1.5 m ledge", 2.5),
        VehicleInfo("hmmwv landed again"),
        Quit,
    ],
)
