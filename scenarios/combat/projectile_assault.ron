// Assault kit on Strike at Karkand: a smoke grenade (thrown, bounces, 4 s fuse, a cloud that
// hides and blocks the view inside), then the GP-30 under-barrel launcher (armed after
// 0.3 s: close to a wall the shell bounces off instead of exploding). Throws, bounces,
// detonations and damage are logged by `game_server::combat`.
// client --scenario scenarios/combat/projectile_assault.ron --out target/scenarios/projectile/assault
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        Wait(1.0),
        Click("kit:2"),
        Wait(16.0),
        // Smoke grenade, thrown south across the square.
        Teleport((-184.0, 157.0, -85.0), 180.0, 12.0),
        Weapon(5),
        Wait(1.5),
        Screenshot("smoke_ready"),
        Hold([Fire]),
        Wait(0.3),
        Screenshot("smoke_windup"),
        Wait(0.3),
        Release([Fire]),
        Wait(0.25),
        Screenshot("smoke_throw"),
        Wait(0.4),
        Screenshot("smoke_flight"),
        Wait(4.5),
        Look(180.0, -3.0),
        Screenshot("smoke_cloud_1"),
        Wait(2.0),
        Screenshot("smoke_cloud_3"),
        // Into the middle of the cloud.
        Teleport((-184.0, 157.0, -67.0), 180.0, 0.0),
        Wait(0.3),
        Screenshot("smoke_inside"),
        Teleport((-184.0, 157.0, -79.0), 180.0, 0.0),
        Wait(0.3),
        Screenshot("smoke_edge"),
        Wait(6.0),
        Screenshot("smoke_gone"),
        // GP-30 across the square.
        Teleport((-184.0, 157.0, -85.0), 180.0, 4.0),
        Weapon(1),
        Wait(2.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Screenshot("gp30_flight"),
        Wait(0.6),
        Screenshot("gp30_boom"),
        Wait(1.0),
        // 6 m from a wall: the shell hits it before arming, bounces off and goes off on the
        // next impact.
        Teleport((-184.0, 157.0, -30.0), 180.0, 0.0),
        Hold([Reload]),
        Wait(0.1),
        Release([Reload]),
        Wait(4.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.5),
        Screenshot("gp30_dud"),
        Wait(1.0),
        Quit,
    ],
)
