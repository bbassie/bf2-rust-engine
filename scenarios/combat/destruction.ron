// Destroyable objects on Strike at Karkand: a fuel barrel shot until it explodes, the boards
// across the corrugated fence knifed, a fuel tank trailer and a traffic light hit by rifle
// grenades. Damage and destruction are logged by `game_server::destruction`.
// client --scenario scenarios/combat/destruction.ron --out target/scenarios/destruction/all
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        // Yellow barrel (statics #1575), 7 m to the south: ~5 rifle hits (37 x 0.3 vs 50 HP).
        // Its blast (150, 9 m) still reaches us.
        Teleport((-188.99, 156.2, 41.3), 180.0, -8.9),
        Wait(1.5),
        Screenshot("barrel_before"),
        Hold([Aim]),
        Wait(0.6),
        Hold([Fire]),
        Wait(0.4),
        Screenshot("barrel_blast_1"),
        Wait(0.2),
        Screenshot("barrel_blast_2"),
        Wait(0.2),
        Screenshot("barrel_blast_3"),
        Release([Fire]),
        Wait(0.5),
        Screenshot("barrel_debris"),
        Release([Aim]),
        Wait(3.0),
        Screenshot("barrel_after"),
        // Boards across the fence gap (#803), 1.2 m ahead: two knife stabs (30 each, 50 HP).
        Teleport((-170.08, 156.3, 66.2), 0.0, -8.0),
        Weapon(3),
        Wait(1.5),
        Screenshot("boards_before"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.6),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.15),
        Screenshot("boards_break"),
        Wait(2.0),
        Screenshot("boards_after"),
        // The gap is open now: walk through it.
        Move(0.0, 1.0),
        Wait(1.5),
        Move(0.0, 0.0),
        Look(180.0, -5.0),
        Wait(0.5),
        Screenshot("boards_walked_through"),
        // Fuel tank trailer (#958), 15 m to the west: one rifle grenade (150 splash, 50 HP).
        Teleport((-154.29, 156.3, -3.19), 90.0, -1.7),
        Weapon(1),
        Wait(2.0),
        Screenshot("wagon_before"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.35),
        Screenshot("wagon_blast"),
        Wait(3.0),
        Screenshot("wagon_after"),
        // Traffic light (#959), 12 m to the east: bullets don't hurt it (glass, 0), a grenade
        // at its foot does.
        Hold([Reload]),
        Wait(0.1),
        Release([Reload]),
        Teleport((-173.0, 156.3, -79.08), -90.0, -7.0),
        Wait(4.0),
        Screenshot("light_before"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.4),
        Screenshot("light_blast"),
        Wait(2.5),
        Screenshot("light_after"),
        Quit,
    ],
)
