// A smoke grenade close by on Strike at Karkand: the cloud from outside while it spreads,
// thickens and thins out, and the view from inside it.
// client --scenario scenarios/combat/projectile_smoke.ron --out target/scenarios/projectile/smoke
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        Wait(1.0),
        Click("kit:2"),
        Wait(16.0),
        Teleport((-184.0, 157.0, -85.0), 180.0, -20.0),
        Weapon(5),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(1.0),
        Screenshot("smoke_landed"),
        Wait(3.4),
        Look(180.0, 0.0),
        Screenshot("smoke_0s"),
        Wait(1.0),
        Screenshot("smoke_1s"),
        Wait(2.0),
        Screenshot("smoke_3s"),
        Teleport((-184.0, 157.0, -100.0), 180.0, 0.0),
        Wait(0.2),
        Screenshot("smoke_3s_far"),
        Teleport((-184.0, 157.0, -85.0), 180.0, 0.0),
        Wait(1.0),
        Move(0.0, 1.0),
        Wait(1.2),
        Move(0.0, 0.0),
        Screenshot("smoke_inside"),
        Wait(4.0),
        Screenshot("smoke_10s"),
        Wait(3.0),
        Screenshot("smoke_gone"),
        Quit,
    ],
)
