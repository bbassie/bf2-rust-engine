// Tear gas on Night Flight: the support kit fires its tear gas launcher at its own feet and
// steps to the edge of the cloud. The view swims and blurs, the soldier coughs and loses a
// little health; the gas mask stops it.
// client --scenario scenarios/combat/gadgets_teargas.ron --out target/scenarios/gadgets/teargas
(
    level: "night_flight",
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        Wait(1.0),
        // The support kit carries the tear gas launcher.
        Click("kit:3"),
        Wait(11.0),
        Teleport((-126.35, 19.4, 1.46), 270.0, -85.0),
        Weapon(8),
        Wait(2.5),
        Vitals("before"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        // In the cloud (its smoke hides everything), then at its edge looking back into it.
        Wait(5.0),
        Teleport((-121.6, 19.4, 1.46), 90.0, -5.0),
        Wait(1.0),
        Screenshot("gassed"),
        Wait(4.0),
        Screenshot("gassed_2"),
        Wait(0.1),
        Vitals("gassed"),
        Key(KeyK),
        Wait(3.0),
        Screenshot("masked"),
        Vitals("masked"),
        Quit,
    ],
)
