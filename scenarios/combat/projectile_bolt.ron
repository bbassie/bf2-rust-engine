// Bolt-action rifles fire once per BF2 `animation.shiftDelay` (1.8 s for the M24), however
// fast the trigger is pulled: four pulls within 1.2 s fire one round (the ammo counter reads
// 4), a pull 2 s after the first fires the second (3).
// client --scenario scenarios/combat/projectile_bolt.ron --out target/scenarios/projectile/bolt
(
    level: "strike_at_karkand",
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        WaitDeployScreen(3.0),
        Click("kit:1"),
        WaitSpawned(20.0),
        Teleport((-184.0, 157.0, -85.0), 180.0, 1.0),
        Weapon(5),
        Wait(2.5),
        Screenshot("m24_ready"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Screenshot("m24_after_three_pulls"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.6),
        Screenshot("m24_after_four_pulls"),
        Wait(0.3),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.3),
        Screenshot("m24_after_two_seconds"),
        Quit,
    ],
)
