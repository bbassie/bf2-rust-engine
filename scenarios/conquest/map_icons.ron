// Flag and vehicle icons in game: the ticket bar and flag pills with the teams' flags and
// letters, the minimap (rotating and north up) and the big map with flag icons, placed labels
// and vehicles (grey empty ones at the US base, ours in white with the turret line once we
// sit in the M1A2 and turn the turret), the scoreboard's team flags, the deploy screen's
// markers and the commander screen; and the base's vehicles at the minimap's edge (118 m
// in front of the M1A2, both rotation modes: cut off at the frame, not spilling out of it).
// For a bigger window add `--settings` with a
// `(window_size: (1920, 1080))` file.
// client --scenario scenarios/conquest/map_icons.ron --out target/scenarios/map_icons
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 12,
    steps: [
        WaitReady,
        Wait(1.5),
        Screenshot("hud"),
        Key(KeyN),
        Wait(0.2),
        Screenshot("hud_north"),
        Key(KeyN),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("bigmap"),
        ReleaseKey(KeyM),
        HoldKey(Tab),
        Wait(0.3),
        Screenshot("scoreboard"),
        ReleaseKey(Tab),
        Key(Enter),
        Wait(0.5),
        Screenshot("deploy"),
        Key(Enter),
        Wait(0.3),
        InFrontOf("ustnk_m1a2", 118.0),
        Wait(0.5),
        Screenshot("minimap_edge"),
        Key(KeyN),
        Wait(0.2),
        Screenshot("minimap_edge_north"),
        Key(KeyN),
        NearVehicle("ustnk_m1a2"),
        Wait(1.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleLook(70.0, 0.0),
        Wait(2.5),
        Screenshot("tank_minimap"),
        Key(KeyN),
        Wait(0.2),
        Screenshot("tank_minimap_north"),
        Key(KeyN),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("tank_bigmap"),
        ReleaseKey(KeyM),
        Commander(Apply),
        Wait(1.0),
        Key(CapsLock),
        Wait(0.8),
        Screenshot("commander"),
        Key(CapsLock),
        Quit,
    ],
)
