// The map styles (`map_style`): the minimap in the tactical and the classic style at three
// sizes (0.75, 1.0, 1.5: map, icons, our marker and pinned objectives all scale), objectives
// out of range pinned to the tactical minimap's edge, our squad (numbered) and the dashed
// line to its order, the big map, the deploy map and the HUD's objective row in the tactical
// style, and the minimap easing out (never jumping) once we drive the HMMWV fast.
// client --scenario scenarios/conquest/map_style.ron --out target/scenarios/map_style
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 12,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        Setting("map_style", "tactical"),
        // Our squad and an order for it (given as commander, who then resigns).
        Commander(Apply),
        Wait(1.0),
        Commander(Order(squad: 1, kind: Attack, target: (-80.0, 0.0, 120.0))),
        Wait(1.5),
        Key(CapsLock),
        Wait(0.8),
        Screenshot("commander"),
        Key(CapsLock),
        Wait(0.3),
        Commander(Resign),
        Wait(1.0),
        Squad(Join(1)),
        Wait(2.0),
        Teleport((-184.0, 157.0, -85.0), 30.0, -4.0),
        Wait(1.5),
        Screenshot("tactical_100"),
        Setting("minimap_size", "0.75"),
        Wait(0.4),
        Screenshot("tactical_075"),
        Setting("minimap_size", "1.5"),
        Wait(0.4),
        Screenshot("tactical_150"),
        Key(KeyN),
        Wait(0.3),
        Screenshot("tactical_150_north"),
        Key(KeyN),
        Setting("minimap_size", "1.0"),
        Setting("map_style", "classic"),
        Wait(0.4),
        Screenshot("classic_100"),
        Setting("minimap_size", "0.75"),
        Wait(0.4),
        Screenshot("classic_075"),
        Setting("minimap_size", "1.5"),
        Wait(0.4),
        Screenshot("classic_150"),
        Setting("minimap_size", "1.0"),
        Setting("map_style", "tactical"),
        Wait(0.4),
        HoldKey(KeyM),
        Wait(0.6),
        Screenshot("bigmap"),
        ReleaseKey(KeyM),
        Wait(0.3),
        Key(Enter),
        Wait(0.6),
        Screenshot("deploy"),
        Key(Enter),
        Wait(0.3),
        Setting("map_style", "classic"),
        HoldKey(KeyM),
        Wait(0.6),
        Screenshot("bigmap_classic"),
        ReleaseKey(KeyM),
        Setting("map_style", "tactical"),
        // Driving fast: the minimap eases out over a second or two.
        NearVehicle("usjep_hmmwv"),
        Wait(1.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ExpectLog("minimap: Vehicle range", 3.0),
        Screenshot("drive_00_parked"),
        // Out on the road north of the Gas Station at 65 km/h, throttle held.
        PlaceVehicle((-148.0, 163.0, 262.0), 0.0, 18.0),
        Move(0.0, 1.0),
        Screenshot("drive_01_placed"),
        Wait(0.7),
        Screenshot("drive_02"),
        Wait(0.7),
        Screenshot("drive_03"),
        VehicleInfo("fast"),
        Wait(0.7),
        Screenshot("drive_04"),
        Move(-0.6, 1.0),
        Wait(0.8),
        Screenshot("drive_05"),
        Move(0.0, -1.0),
        Wait(1.5),
        Move(0.0, 0.0),
        VehicleInfo("braked"),
        Wait(1.5),
        Screenshot("drive_06_stopping"),
        Wait(2.0),
        Screenshot("drive_07_stopped"),
        Quit,
    ],
)
