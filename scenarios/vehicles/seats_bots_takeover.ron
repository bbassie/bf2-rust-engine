// A bot takes the controls from us on the move (bots::vehicle::Ride::take_over): on Wake
// Island we take off in the Z-10 with a bot gunner, climb to about 60 m and press F2: we gun,
// the bot flies on (no ground take-off, no drop out of the sky: it stays at least 20 m up for
// 15 s; the report traces the altitude every 0.25 s). No crash.
// client --scenario scenarios/vehicles/seats_bots_takeover.ron --out target/scenarios/vehicles/seats_bots_takeover
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 12,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        ForbidLog("ahe_z10 crashed"),
        Wait(3.0),
        NearVehicle("ahe_z10"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.3),
        SeatBot("ahe_z10", 2),
        LogSeats("ahe_z10"),
        ThirdPerson(true),
        VehicleTrace("spin up", 6.0),
        Move(0.0, 1.0),
        VehicleTrace("climb", 4.5),
        Move(0.0, 0.0),
        VehicleTrace("hover", 2.0),
        Screenshot("01_we_fly_60m"),
        Log("F2: we gun, the bot flies"),
        Seat(2),
        ExpectLog("swapped seats with", 3.0),
        ExpectLog("ahe_z10 takes over at", 3.0),
        LogSeats("ahe_z10"),
        VehicleTrace("bot flies", 1.0),
        Screenshot("02_bot_flies_1s"),
        VehicleKeeps("bot flies", 20.0, 0.0, 6.0),
        VehicleTrace("bot flies later", 0.1),
        Screenshot("03_bot_flies_7s"),
        VehicleKeeps("bot flies on", 20.0, 0.0, 8.0),
        VehicleTrace("bot flies end", 0.1),
        Screenshot("04_bot_flies_15s"),
        LogSeats("ahe_z10"),
        Quit,
    ],
)
