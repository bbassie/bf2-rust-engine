// First-person views of the T-90 on Karkand: the driver/gunner's sight (interior model and
// BF2's sight overlay), turned left and aimed up, then the cupola gunner; and the same for
// the BTR-90 next to it.
// client --scenario scenarios/vehicles/vehicle2_tank_views.ron --out target/scenarios/vehicle2/tank_views
(
    level: "strike_at_karkand",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("rutnk_t90"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        VehicleInfo("t90 driver"),
        VehicleLook(0.0, 0.0),
        Wait(1.5),
        Screenshot("t90_driver"),
        VehicleLook(-40.0, 5.0),
        Wait(2.0),
        Screenshot("t90_driver_left"),
        Seat(2),
        Wait(1.0),
        VehicleInfo("t90 cupola"),
        VehicleLook(20.0, 0.0),
        Wait(1.5),
        Screenshot("t90_cupola"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        NearVehicle("apc_btr90"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        VehicleInfo("btr90 driver"),
        VehicleLook(0.0, 0.0),
        Wait(1.5),
        Screenshot("btr90_driver"),
        Seat(2),
        Wait(1.0),
        VehicleInfo("btr90 seat 2"),
        Screenshot("btr90_seat2"),
        Quit,
    ],
)
