// Bombing with the bomb marker (BF3's CCIP-like dot): take off in the J-10 on Wake Island,
// climb, select the bombs, see the marker wait at the screen's lower edge in level flight,
// push the nose down until it rides on the ground ahead and drop. The HUD logs where it
// predicted the bombs would land; the server logs where they went off. Also the cockpit's
// free look (Alt) straight down.
// client --scenario scenarios/vehicles/jet_bomb_ccip.ron --out target/scenarios/vehicles/jet_bomb_ccip
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("air_j10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        Move(0.0, 1.0),
        VehicleTrace("roll", 7.0),
        Stick(0.0, 0.5),
        VehicleTrace("rotate", 2.0),
        Stick(0.0, 0.0),
        VehicleTrace("climb", 6.0),
        Move(0.0, 0.0),
        Weapon(1),
        Stick(0.0, -0.6),
        VehicleTrace("level off", 1.2),
        Stick(0.0, 0.0),
        VehicleTrace("level", 1.0),
        VehicleInfo("level"),
        Screenshot("01_level_chase"),
        ThirdPerson(false),
        Wait(0.2),
        Screenshot("02_level_cockpit"),
        // Dive until the marker is on screen, and drop.
        Stick(0.0, -0.8),
        VehicleTrace("push over", 1.0),
        Stick(0.0, 0.0),
        VehicleTrace("dive", 0.5),
        VehicleInfo("dive"),
        Screenshot("03_dive_cockpit"),
        ThirdPerson(true),
        Wait(0.1),
        Screenshot("04_dive_chase"),
        Hold([Aim]),
        ExpectLog("bomb marker: dropped", 2.0),
        Wait(0.3),
        Release([Aim]),
        Stick(0.0, 0.8),
        VehicleTrace("pull out", 1.5),
        Stick(0.0, 0.0),
        ExpectLog("went off", 30.0),
        VehicleTrace("after", 1.0),
        // The cockpit's free look straight down.
        ThirdPerson(false),
        HoldKey(AltLeft),
        VehicleLook(0.0, -89.0),
        Wait(0.3),
        VehicleInfo("free look cockpit"),
        Screenshot("05_free_look_cockpit"),
        ReleaseKey(AltLeft),
        ForbidLog("panicked"),
        Quit,
    ],
)
