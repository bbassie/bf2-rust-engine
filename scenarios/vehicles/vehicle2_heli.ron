// Flying the Z-10 attack helicopter from the Chinese airfield on Wake Island: the rotor
// spins up, lift off, hover (the collective holds the altitude hands off), yaw, nose down
// into forward flight, a banked turn, flare and hover again. The report traces speed,
// altitude above ground, climb rate, attitude and rotor speed.
// client --scenario scenarios/vehicles/vehicle2_heli.ron --out target/scenarios/vehicle2/heli
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("ahe_z10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        VehicleTrace("spin up", 6.0),
        Screenshot("01_spun_up"),
        Move(0.0, 1.0),
        VehicleTrace("lift off", 4.0),
        Move(0.0, 0.0),
        VehicleTrace("hover", 3.0),
        Screenshot("02_hover"),
        Move(1.0, 0.0),
        VehicleTrace("yaw right", 1.5),
        Move(0.0, 0.0),
        Stick(0.0, -0.8),
        VehicleTrace("nose down", 0.5),
        Stick(0.0, 0.0),
        VehicleTrace("forward", 8.0),
        Screenshot("03_forward"),
        Stick(0.7, 0.0),
        VehicleTrace("bank", 0.6),
        Stick(0.0, 0.2),
        VehicleTrace("turn", 3.0),
        Screenshot("04_turn"),
        Stick(-0.7, 0.0),
        VehicleTrace("level", 0.6),
        Stick(0.0, 0.8),
        VehicleTrace("flare", 1.0),
        Stick(0.0, 0.0),
        VehicleTrace("slow down", 6.0),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("05_cockpit"),
        Move(0.0, -1.0),
        VehicleTrace("descend", 4.0),
        Quit,
    ],
)
