// Parachute, bailing out of the J-10 high over Wake Island: the canopy opens (the fall is
// caught over a moment), BF2's canopy and parachute pose show in third person and, looking
// up, in first person; it glides where the soldier looks (turning at most 70 deg/s towards the view), W dives,
// S brakes, it flares near the ground, and after landing the canopy collapses. The Trace
// lines carry the soldier's position and velocity every frame (sink rate = -vel y).
// client --scenario scenarios/vehicles/vfeel_parachute.ron --out target/scenarios/vfeel/parachute
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("air_j10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        Move(0.0, 1.0),
        Wait(1.0),
        PlaceVehicle((407.0, 230.0, 420.0), 0.0, 60.0),
        Move(0.0, 0.0),
        Wait(0.3),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Look(0.0, -10.0),
        ThirdPerson(true),
        Trace("opening", 2.5),
        Screenshot("01_open_third_person"),
        Trace("glide", 2.0),
        Move(0.0, 1.0),
        Trace("dive", 3.0),
        Move(0.0, -1.0),
        Trace("brake", 3.0),
        Move(0.0, 0.0),
        Look(15.0, -10.0),
        Trace("turn left", 2.5),
        Screenshot("02_turning"),
        Look(15.0, 70.0),
        ThirdPerson(false),
        Wait(0.5),
        Screenshot("03_first_person_up"),
        Look(15.0, -30.0),
        Wait(0.3),
        Screenshot("04_first_person_down"),
        ThirdPerson(true),
        Look(15.0, -20.0),
        Trace("descent", 25.0),
        Screenshot("05_landed"),
        Wait(0.8),
        Screenshot("06_collapsing"),
        Wait(1.5),
        Screenshot("07_packed_away"),
        ForbidLog("panicked"),
        Quit,
    ],
)
