// Flying the J-10 from the Chinese airfield on Wake Island: full throttle down the runway,
// rotate, climb out with the gear coming up, roll into a turn, level out, afterburner. The
// report traces speed, altitude above ground, climb rate and attitude.
// client --scenario scenarios/vehicles/vehicle2_jet.ron --out target/scenarios/vehicle2/jet
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("air_j10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleInfo("entered"),
        ThirdPerson(true),
        Wait(0.5),
        Screenshot("01_parked"),
        Move(0.0, 1.0),
        VehicleTrace("roll", 7.0),
        Screenshot("02_takeoff_roll"),
        Stick(0.0, 0.5),
        VehicleTrace("rotate", 2.0),
        Stick(0.0, 0.0),
        VehicleTrace("climb", 5.0),
        Screenshot("03_climb"),
        Stick(0.8, 0.0),
        VehicleTrace("roll in", 0.6),
        Stick(0.0, 0.6),
        VehicleTrace("turn", 3.0),
        Screenshot("04_turn"),
        Stick(-0.8, 0.0),
        VehicleTrace("roll out", 0.6),
        Stick(0.0, 0.0),
        Hold([Sprint]),
        VehicleTrace("afterburner", 5.0),
        Release([Sprint]),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("05_cockpit"),
        Move(0.0, 0.0),
        VehicleTrace("cruise", 3.0),
        Quit,
    ],
)
