// The LAV-25 and the M1A2 at the US main base: get in, drive, turn, aim the turret, get out.
// The report logs speed, heading and tilt along the way.
// client --scenario scenarios/vehicles/vehicle_armor.ron --out target/scenarios/vehicle/armor
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),

        // LAV-25 (wheeled APC).
        NearVehicle("usapc_lav25"),
        Wait(1.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleInfo("lav entered"),
        ThirdPerson(true),
        VehicleLook(0.0, -10.0),
        Wait(0.3),
        Screenshot("lav_chase"),
        Move(0.0, 1.0),
        Wait(3.0),
        VehicleInfo("lav throttle 3 s"),
        Wait(3.0),
        VehicleInfo("lav throttle 6 s"),
        Screenshot("lav_driving"),
        Move(-1.0, 1.0),
        Wait(2.0),
        VehicleInfo("lav turning left 2 s"),
        Move(0.0, -1.0),
        Wait(2.0),
        VehicleInfo("lav braking 2 s"),
        Move(0.0, 0.0),
        VehicleLook(60.0, 5.0),
        Wait(2.0),
        VehicleInfo("lav turret left"),
        Screenshot("lav_turret"),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("lav_gunner_view"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),

        // M1A2 (tracked).
        NearVehicle("ustnk_m1a2"),
        Wait(1.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleInfo("tank entered"),
        ThirdPerson(true),
        VehicleLook(0.0, -10.0),
        Wait(0.3),
        Screenshot("tank_chase"),
        Move(0.0, 1.0),
        Wait(3.0),
        VehicleInfo("tank throttle 3 s"),
        Wait(3.0),
        VehicleInfo("tank throttle 6 s"),
        Screenshot("tank_driving"),
        Move(0.0, 0.0),
        Wait(2.0),
        VehicleInfo("tank coasting 2 s"),
        Move(1.0, 0.0),
        Wait(3.0),
        VehicleInfo("tank pivot right 3 s"),
        Move(0.0, 0.0),
        VehicleLook(-90.0, 8.0),
        Wait(4.0),
        VehicleInfo("tank turret right"),
        Screenshot("tank_turret_right"),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("tank_gunner_view"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        VehicleInfo("tank got out"),
        ThirdPerson(true),
        Screenshot("tank_exited"),
        Quit,
    ],
)
