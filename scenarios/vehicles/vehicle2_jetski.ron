// The xpack jet ski on Leviathan's water, next to the RIB for a direct comparison: floating at
// rest, then full throttle held long enough to reach an equilibrium top speed. Two bugs here
// (game_shared::flight, bf2_import::vehicles): the water-jet thruster sat above the floaters'
// draft line so the throttle never did anything at all, and once that was fixed the jet ski's
// `nopropellereffectatspeed` (the importer's stand-in for a water thruster's top speed) was
// missing from BF2's data and fell back to the slow-paddling default meant for amphibious land
// vehicles' water jets (7 m/s), capping it far below drag's actual limit; both boats' own
// engines leave it unset too and are meant to coast as far as drag allows (the RIB's explicit
// 150 m/s). The report's two VehicleInfo lines give both top speeds to compare.
// client --scenario scenarios/vehicles/vehicle2_jetski.ron --out target/scenarios/vehicle2/jetski
(
    level: "leviathan",
    size: 32,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(3.0),

        NearVehicle("boat_rib"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        VehicleTrace("rib afloat", 1.0),
        Move(0.0, 1.0),
        VehicleTrace("rib throttle", 14.0),
        Screenshot("01_rib_speed"),
        VehicleInfo("rib top speed"),
        Move(0.0, 0.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),

        NearVehicle("xpak_jetski"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleTrace("jetski afloat", 1.0),
        Move(0.0, 1.0),
        VehicleTrace("jetski throttle", 22.0),
        Screenshot("02_jetski_speed"),
        VehicleInfo("jetski top speed"),
        Move(0.0, 0.0),
        VehicleTrace("jetski coast", 2.0),
        Quit,
    ],
)
