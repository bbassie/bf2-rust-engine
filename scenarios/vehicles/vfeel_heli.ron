// Helicopter handling (BF3-style assists over BF2's rotor data), Z-10 on Wake Island: spin
// up, lift off, hover hands off (the drift dies out), pedal turn, forward flight with the
// stick held (the tilt stops at its limit) and let go (it levels out), a banked turn (it
// turns into the bank), a flare, backwards (slow), sideways, and down to the ground.
// `python scripts/flight_rates.py <out>/report.txt` turns the trace into rates.
// client --scenario scenarios/vehicles/vfeel_heli.ron --out target/scenarios/vfeel/heli
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("ahe_z10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        VehicleTrace("spin up", 6.0),
        Move(0.0, 1.0),
        VehicleTrace("lift off", 3.0),
        Move(0.0, 0.0),
        VehicleTrace("hover", 4.0),
        Screenshot("01_hover"),
        Move(1.0, 0.0),
        VehicleTrace("pedal", 1.5),
        Move(0.0, 0.0),
        VehicleTrace("pedal off", 1.0),
        Stick(0.0, -0.6),
        VehicleTrace("nose down held", 4.0),
        Screenshot("02_forward"),
        Stick(0.0, 0.0),
        VehicleTrace("let go", 3.0),
        Stick(0.0, -0.3),
        VehicleTrace("cruise", 4.0),
        Stick(0.35, -0.2),
        VehicleTrace("banked turn", 4.0),
        Screenshot("03_turn"),
        Stick(0.0, 0.0),
        VehicleTrace("level out", 2.0),
        Stick(0.0, 0.8),
        VehicleTrace("flare", 1.5),
        Stick(0.0, 0.0),
        VehicleTrace("settle", 4.0),
        Stick(0.0, 0.5),
        VehicleTrace("backwards", 4.0),
        Stick(0.0, 0.0),
        VehicleTrace("stop", 3.0),
        Stick(0.6, 0.0),
        VehicleTrace("sideways", 3.0),
        Stick(0.0, 0.0),
        ThirdPerson(false),
        VehicleTrace("hover again", 3.0),
        Screenshot("04_cockpit"),
        Move(0.0, -1.0),
        VehicleTrace("descend", 8.0),
        ForbidLog("panicked"),
        Quit,
    ],
)
