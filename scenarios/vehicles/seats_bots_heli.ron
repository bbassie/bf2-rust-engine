// Players take priority over bots for seats in aircraft (game_server::vehicles::boarding), on
// Wake Island's Z-10: a bot pilot on the ground moves to the gunner seat when we get in. Full of
// bots on the ground, the bot pilot gets out beside it. Full of bots 5 m up (too low for a
// parachute) nobody is thrown out: we can't get in ("can't get out here"). 25 m higher, the
// bot pilot is put out under his parachute and we fly it.
// client --scenario scenarios/vehicles/seats_bots_heli.ron --out target/scenarios/vehicles/seats_bots_heli
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 20,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        Wait(3.0),
        NearVehicle("ahe_z10"),
        Log("a bot pilot on the ground; we get in"),
        SeatBot("ahe_z10", 1),
        NearVehicle("ahe_z10"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        ExpectLog("who moved to seat 1", 3.0),
        ExpectLog("was moved to seat 1 of ahe_z10 to Gun", 3.0),
        LogSeats("ahe_z10"),
        ThirdPerson(true),
        VehicleLook(120.0, -15.0),
        Wait(1.0),
        Screenshot("01_we_fly_bot_guns"),
        Log("out; bots fill it on the ground; in again: the bot pilot gets out"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        SeatBot("ahe_z10", 0),
        NearVehicle("ahe_z10"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        ExpectLog("who got out at", 3.0),
        LogSeats("ahe_z10"),
        VehicleLook(-100.0, -10.0),
        Wait(1.0),
        Screenshot("02_bot_pilot_out"),
        Log("out; bots fill it 5 m up: nobody is thrown out"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        SeatBot("ahe_z10", 0),
        LiftVehicle("ahe_z10", 5.0),
        // (NearVehicle goes by where it is drawn: once it moved up.)
        Wait(0.1),
        NearVehicle("ahe_z10"),
        Hold([Use]),
        Wait(0.1),
        Release([Use]),
        ExpectLog("can't get out here", 3.0),
        LogSeats("ahe_z10"),
        Log("25 m higher: the bot pilot bails out under his parachute"),
        LiftVehicle("ahe_z10", 25.0),
        Wait(0.1),
        NearVehicle("ahe_z10"),
        Hold([Use]),
        Wait(0.1),
        Release([Use]),
        ExpectLog("under a parachute", 3.0),
        LogSeats("ahe_z10"),
        VehicleLook(-120.0, -30.0),
        Wait(1.5),
        Screenshot("03_bot_parachute"),
        Quit,
    ],
)
