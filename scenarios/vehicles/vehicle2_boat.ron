// A RIB on Wake Island's lagoon side: floating at rest, full throttle, a hard turn, reverse,
// and the gunner's seat. The report traces speed, height above the sea floor and attitude.
// client --scenario scenarios/vehicles/vehicle2_boat.ron --out target/scenarios/vehicle2/boat
(
    level: "wake_island_2007",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(3.0),
        NearVehicle("boat_rib"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        VehicleTrace("afloat", 2.0),
        Screenshot("01_afloat"),
        Move(0.0, 1.0),
        VehicleTrace("throttle", 6.0),
        Screenshot("02_speed"),
        Move(1.0, 1.0),
        VehicleTrace("turn right", 4.0),
        Screenshot("03_turn"),
        Move(0.0, 0.0),
        VehicleTrace("coast", 3.0),
        Move(0.0, -1.0),
        VehicleTrace("reverse", 3.0),
        Move(0.0, 0.0),
        Seat(2),
        Wait(0.5),
        VehicleInfo("gunner"),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("04_gunner"),
        Quit,
    ],
)
