// The M1A2's guns: the main gun at a parked (empty) LAV-25 until it is a wreck, then the
// coaxial machine gun. Server log lines "... destroyed" confirm the kill.
// client --scenario scenarios/vehicles/vehicle_weapons.ron --out target/scenarios/vehicle/weapons
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("ustnk_m1a2"),
        Wait(1.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        // The LAV-25 parked east of the tank, by the gas station.
        Look(-66.0, -2.0),
        Wait(3.0),
        VehicleInfo("aimed"),
        ThirdPerson(true),
        Wait(0.2),
        Screenshot("aim"),
        ThirdPerson(false),
        Hold([Fire]),
        Wait(0.15),
        Screenshot("fire"),
        Release([Fire]),
        Wait(3.5),
        Hold([Fire]),
        Wait(0.15),
        Release([Fire]),
        Wait(3.5),
        Hold([Fire]),
        Wait(0.15),
        Release([Fire]),
        Wait(1.5),
        Screenshot("destroyed"),
        ThirdPerson(true),
        Wait(0.2),
        Screenshot("destroyed_chase"),
        Look(-40.0, -2.0),
        Wait(1.5),
        Hold([Aim]),
        Wait(0.6),
        Screenshot("coax"),
        Release([Aim]),
        Wait(0.5),
        VehicleInfo("done"),
        // Out of the tank, over to the wreck (still there for a few seconds).
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        Teleport((-126.0, 162.3, 293.0), 80.0, -12.0),
        ThirdPerson(true),
        Wait(1.0),
        Screenshot("wreck"),
        Quit,
    ],
)
