// Bailing out of the J-10 over Wake Island: take off, climb, get out (E) high up; the pilot's
// parachute opens, he glides where the keys steer and lands. Screenshots from behind.
// client --scenario scenarios/vehicles/vehicle2_bailout.ron --out target/scenarios/vehicle2/bailout
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("air_j10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        Move(0.0, 1.0),
        VehicleTrace("roll", 7.0),
        Stick(0.0, 0.5),
        VehicleTrace("rotate", 2.0),
        Stick(0.0, 0.0),
        VehicleTrace("climb", 6.0),
        Move(0.0, 0.0),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.5),
        Look(0.0, -20.0),
        Screenshot("01_parachute_open"),
        Move(0.0, 1.0),
        Wait(4.0),
        Screenshot("02_gliding"),
        Wait(12.0),
        Screenshot("03_lower"),
        Move(0.0, 0.0),
        Wait(12.0),
        Screenshot("04_landed"),
        Quit,
    ],
)
