// Gamepad vehicle controls: entering with RB (Use), throttle/brake on the triggers, steering
// on the left stick, and exiting. Mirrors vehicle_hmmwv.ron's keyboard run.
// client --scenario scenarios/vehicles/vehicle_gamepad.ron --out target/scenarios/vehicle/gamepad
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("usjep_hmmwv"),
        GamepadConnect,
        ThirdPerson(true),
        Wait(1.5),
        Screenshot("outside"),
        GamepadHold([RightTrigger]),
        Wait(0.2),
        GamepadRelease([RightTrigger]),
        Wait(0.5),
        VehicleInfo("entered (gamepad RB)"),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("driver_view"),
        // Out of the gas station, throttle on the right trigger.
        GamepadTriggers(0.0, 1.0),
        Wait(1.5),
        VehicleInfo("throttle 1.5 s (gamepad RT)"),
        // Steer right with the left stick, still on the throttle.
        GamepadLeftStick(1.0, 0.0),
        Wait(1.6),
        VehicleInfo("steered right (gamepad left stick)"),
        GamepadLeftStick(0.0, 0.0),
        Wait(2.0),
        VehicleInfo("straight 2 s"),
        Screenshot("driving"),
        // Brake on the left trigger.
        GamepadTriggers(1.0, 0.0),
        Wait(1.5),
        VehicleInfo("braking (gamepad LT)"),
        GamepadTriggers(0.0, 0.0),
        Wait(1.0),
        VehicleInfo("released"),
        GamepadHold([RightTrigger]),
        Wait(0.2),
        GamepadRelease([RightTrigger]),
        Wait(1.0),
        VehicleInfo("got out"),
        ThirdPerson(true),
        Wait(0.3),
        Screenshot("exited"),
        GamepadDisconnect,
        Quit,
    ],
)
