// Tracks and wheels while driving: the T-90 and the M1A2 on Karkand drive off, seen from
// the side by the chase camera, close up (road wheels, sprockets and track belts at speed,
// consecutive frames to see the belts move with the ground).
// client --scenario scenarios/vehicles/vehicle2_tracks.ron --out target/scenarios/vehicle2/tracks
(
    level: "strike_at_karkand",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        NearVehicle("rutnk_t90"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        PlaceVehicle((-200.6, 157.5, -505.0), 180.0, 0.0),
        Wait(2.0),
        ThirdPerson(true),
        ChaseZoom(0.6),
        VehicleLook(90.0, 0.0),
        Wait(0.5),
        Screenshot("t90_0_standing"),
        VehicleInfo("t90 standing"),
        Move(0.0, 1.0),
        Wait(4.0),
        Screenshot("t90_1_driving"),
        VehicleInfo("t90 driving"),
        Frames(2),
        Screenshot("t90_2_driving_later"),
        Frames(2),
        Screenshot("t90_3_driving_later"),
        Move(0.0, 0.0),
        Wait(0.2),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        NearVehicle("ustnk_m1a2"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        PlaceVehicle((-195.0, 157.5, -505.0), 180.0, 0.0),
        Wait(2.0),
        ThirdPerson(true),
        VehicleLook(90.0, 0.0),
        Wait(0.5),
        VehicleInfo("m1a2 standing"),
        Screenshot("m1a2_0_standing"),
        Move(0.0, 1.0),
        Wait(4.0),
        Screenshot("m1a2_1_driving"),
        VehicleInfo("m1a2 driving"),
        Frames(3),
        Screenshot("m1a2_2_driving_later"),
        Move(0.0, 0.0),
        Wait(3.0),
        VehicleInfo("m1a2 stopped"),
        Screenshot("m1a2_3_stopped"),
        Quit,
    ],
)
