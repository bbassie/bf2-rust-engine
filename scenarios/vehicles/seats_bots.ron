// Players take priority over bots for seats (game_server::vehicles::boarding), on Karkand:
// a bot drives a Vodnik, we get in: we drive and the bot moves to the gunner seat (its AI
// takes it: "was moved to seat 1"). F2, the bot's seat: we swap (the bot drives, "seat 0 ...
// to Drive"), F1 swaps back. We get out, bots fill every seat, we get in again: the bot
// driver gets out and stands beside the Vodnik. Checked through the server's log lines and
// LogSeats; screenshots of each.
// client --scenario scenarios/vehicles/seats_bots.ron --out target/scenarios/vehicles/seats_bots
(
    level: "strike_at_karkand",
    size: 64,
    team: 1,
    bots: 20,
    steps: [
        WaitReady,
        ForbidLog("panicked"),
        WaitBotsDeployed(20, 10.0),
        NearVehicle("jep_vodnik"),
        Log("a bot drives; we get in"),
        SeatBot("jep_vodnik", 1),
        LogSeats("jep_vodnik"),
        NearVehicle("jep_vodnik"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        ExpectLog("who moved to seat 1", 3.0),
        ExpectLog("was moved to seat 1 of jep_vodnik to Gun", 3.0),
        Wait(0.5),
        LogSeats("jep_vodnik"),
        ThirdPerson(true),
        VehicleLook(120.0, -15.0),
        Wait(1.0),
        Screenshot("01_we_drive_bot_guns"),
        Log("F2: the bot's seat, we swap"),
        Seat(2),
        ExpectLog("swapped seats with", 3.0),
        ExpectLog("was moved to seat 0 of jep_vodnik to Drive", 3.0),
        Wait(0.5),
        LogSeats("jep_vodnik"),
        VehicleLook(150.0, -15.0),
        Wait(0.5),
        Screenshot("02_swapped"),
        Log("F1: swap back"),
        Seat(1),
        ExpectLog("swapped seats with", 3.0),
        ExpectLog("was moved to seat 1 of jep_vodnik to Gun", 3.0),
        Wait(0.5),
        LogSeats("jep_vodnik"),
        Log("out; bots fill every seat; in again: the bot driver gets out"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        SeatBot("jep_vodnik", 0),
        LogSeats("jep_vodnik"),
        NearVehicle("jep_vodnik"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        ExpectLog("who got out at", 3.0),
        ExpectLog("got out of jep_vodnik (thrown out)", 3.0),
        Wait(0.5),
        LogSeats("jep_vodnik"),
        VehicleLook(-100.0, -10.0),
        Wait(0.5),
        Screenshot("03_bot_got_out"),
        Quit,
    ],
)
