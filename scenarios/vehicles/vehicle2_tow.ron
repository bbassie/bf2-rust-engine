// The HJ-8 anti-tank launcher on Karkand (a MEC flag): get on, aim left and up, fire a
// wire-guided missile and steer it by turning the sight, then get off.
// client --scenario scenarios/vehicles/vehicle2_tow.ron --out target/scenarios/vehicle2/tow
(
    level: "strike_at_karkand",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("ats_hj8"),
        ThirdPerson(true),
        Wait(0.5),
        Screenshot("01_launcher"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleInfo("on the launcher"),
        VehicleLook(0.0, 0.0),
        Wait(1.0),
        VehicleInfo("aimed ahead"),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("02_sight"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.6),
        Screenshot("03_launched"),
        VehicleLook(15.0, 3.0),
        Wait(1.5),
        VehicleInfo("steered left"),
        Screenshot("04_guided"),
        Wait(2.0),
        ThirdPerson(true),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        VehicleInfo("got off"),
        Quit,
    ],
)
