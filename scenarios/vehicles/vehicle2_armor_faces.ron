// Per-face armour: a T-90 shells the M1A2 at the US base from the front and the rear
// (45 m, main gun). LogVehicles adds each vehicle's hit points to the report; with
// RUST_LOG=game_server::combat=debug the log names the material each shell hit.
// client --scenario scenarios/vehicles/vehicle2_armor_faces.ron --out target/scenarios/vehicle2/armor_faces
(
    level: "strike_at_karkand",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(1.0),
        NearVehicle("rutnk_t90"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        LogVehicles("all before"),
        // In front of the M1A2 (it faces +x), facing it.
        PlaceVehicle((-128.0, 163.5, 309.1), 90.0, 0.0),
        Wait(2.0),
        VehicleLook(0.0, 0.0),
        Wait(2.5),
        Screenshot("front_aim"),
        Hold([Fire]),
        Wait(0.2),
        Release([Fire]),
        Wait(2.0),
        LogVehicles("all after front hit"),
        // Behind it.
        PlaceVehicle((-217.0, 163.5, 309.1), -90.0, 0.0),
        Wait(2.0),
        VehicleLook(0.0, 0.0),
        Wait(4.0),
        Screenshot("rear_aim"),
        Hold([Fire]),
        Wait(0.2),
        Release([Fire]),
        Wait(2.0),
        LogVehicles("all after rear hit"),
        Quit,
    ],
)
