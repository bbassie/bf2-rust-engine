// Bot strategy: 16 bots play Karkand (16 player layout: Hotel, Square, Market, and the US
// base at the gas station). Squads take orders from their team's commander, move in
// formation and spread out over the flags; the server log has per-minute "ai team" lines
// (captures, kills, orders, behaviours) next to the bots' movement statistics.
// `--debug-nav` draws every bot's path and goal (US red, MEC blue).
// client --scenario scenarios/ai_karkand.ron --debug-nav --out target/scenarios/ai/karkand
(
    level: "strike_at_karkand",
    bots: 16,
    spectate: true,
    steps: [
        WaitReady,
        // The US squads leave their base: members follow their leaders' paths.
        Camera((-150.0, 205.0, 300.0), 10.0, -35.0),
        Wait(10.0),
        Screenshot("advance_10s"),
        // The flags from the south: Hotel in front, Square and Market behind.
        Camera((-200.0, 260.0, 90.0), 0.0, -45.0),
        Wait(30.0),
        Screenshot("overview_40s"),
        // Around the Hotel: defenders' spots in a ring facing the attack, attackers' paths.
        Camera((-150.0, 200.0, 40.0), 41.0, -32.0),
        Wait(20.0),
        Screenshot("hotel_60s"),
        // The Square behind it.
        Camera((-140.0, 200.0, -50.0), 43.0, -34.0),
        Wait(20.0),
        Screenshot("square_80s"),
        Camera((-200.0, 260.0, 90.0), 0.0, -45.0),
        Wait(50.0),
        Screenshot("overview_130s"),
        Camera((-150.0, 200.0, 40.0), 41.0, -32.0),
        Wait(30.0),
        Screenshot("hotel_160s"),
        Quit,
    ],
)
