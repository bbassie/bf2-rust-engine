// Rush on Strike at Karkand (32), as the attacking US: the HUD (our tickets, the stage's two
// charges, STAGE 1/3 | ATTACK), a charge up close with its beacon and HUD marker, arming it
// with the use key (4 s), the armed charge with its fuse, the big map and the deploy screen
// with the charges.
// client --scenario scenarios/modes/rush.ron
(
    level: "strike_at_karkand",
    mode: "gpm_rush",
    size: 32,
    // No bots: nobody to shoot us while we arm the charge (defenders spawn at the Hotel).
    bots: 0,
    team: 2,
    steps: [
        WaitReady,
        ExpectLog("round started: strike_at_karkand Rush", 5.0),
        ExpectLog("charges placed on walkable ground", 30.0),
        Wait(1.0),
        Screenshot("hud"),
        NearCharge("B"),
        Wait(1.5),
        Screenshot("charge"),
        Hold([Use]),
        Wait(2.0),
        Screenshot("arming"),
        ExpectLog("charge B of Stage 1 armed", 6.0),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        Wait(0.5),
        Screenshot("armed"),
        ThirdPerson(false),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("bigmap"),
        ReleaseKey(KeyM),
        Kill,
        WaitDeployScreen(3.0),
        Screenshot("deploy"),
        Quit,
    ],
)
