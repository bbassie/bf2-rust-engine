// Decoy flares and bombs from the J-10 on Wake Island: take off, climb, drop a burst of
// flares (seen from behind), then pick the bombs on the secondary trigger and drop them
// over the island, watching them fall and go off below.
// client --scenario scenarios/vehicle2_flares_bombs.ron --out target/scenarios/vehicle2/flares_bombs
(
    level: "wake_island_2007",
    size: 64,
    team: 1,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("air_j10"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        ThirdPerson(true),
        Move(0.0, 1.0),
        VehicleTrace("roll", 7.0),
        Stick(0.0, 0.5),
        VehicleTrace("rotate", 2.0),
        Stick(0.0, 0.0),
        VehicleTrace("climb", 5.0),
        Move(0.0, 0.0),
        VehicleLook(170.0, -10.0),
        Wait(0.5),
        Hold([Countermeasure]),
        Wait(0.2),
        Release([Countermeasure]),
        Wait(0.6),
        Screenshot("01_flares"),
        Wait(0.8),
        Screenshot("02_flares_later"),
        VehicleInfo("flares"),
        VehicleLook(0.0, 0.0),
        Weapon(1),
        Wait(0.3),
        Screenshot("03_bombs_selected"),
        Hold([Aim]),
        Wait(1.0),
        Release([Aim]),
        VehicleLook(0.0, -70.0),
        VehicleTrace("bombs falling", 2.0),
        Screenshot("04_bombs_falling"),
        VehicleTrace("bombs falling", 3.0),
        Screenshot("05_bombs_below"),
        Wait(1.0),
        Screenshot("06_after"),
        Quit,
    ],
)
