// The commander, checked through the log and screenshots: applying (the deploy screen's
// commander section), the commander screen (Caps Lock) with squads, orders and assets, an
// attack order to squad 1 given on the screen, an artillery strike in front of us (shells
// whistling in, then landing), a UAV over a summoned enemy and a satellite scan (enemies
// marked on the big map), a supply drop on our wounded soldier (floating down, then healing),
// the screen again with the recharging assets, and resigning.
// RUST_LOG=info,game_server::commander=debug target/debug/deps/client.exe --scenario scenarios/commander.ron --out target/scenarios/commander
(
    level: "strike_at_karkand",
    bots: 8,
    team: 2,
    steps: [
        WaitReady,
        Teleport((-150.0, 162.0, 260.0), 180.0, 0.0),
        Wait(1.0),
        Log("apply"),
        Commander(Apply),
        Wait(1.5),
        Key(Enter),
        Wait(0.5),
        Screenshot("deploy"),
        Key(Enter),
        Wait(0.5),
        Log("commander screen"),
        Key(CapsLock),
        Wait(0.8),
        Screenshot("screen"),
        Click("cmd:squad:1"),
        Wait(0.3),
        Click("cmd:order:attack"),
        Wait(0.3),
        Screenshot("screen_order"),
        CommanderClick((-80.0, 0.0, 120.0)),
        Wait(1.5),
        Log("artillery"),
        Click("cmd:asset:artillery"),
        Wait(0.3),
        CommanderClick((-150.0, 0.0, 335.0)),
        Wait(0.5),
        Screenshot("screen_strike"),
        Key(CapsLock),
        Look(180.0, -8.0),
        Wait(3.0),
        Screenshot("artillery_incoming"),
        Wait(1.3),
        Screenshot("artillery_1"),
        Wait(1.5),
        Screenshot("artillery_2"),
        Wait(6.0),
        Log("uav"),
        SummonEnemy(40.0),
        Wait(0.5),
        Commander(Use(asset: Uav, target: (-150.0, 0.0, 300.0))),
        Wait(3.0),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("uav_map"),
        ReleaseKey(KeyM),
        Look(180.0, 40.0),
        Wait(0.5),
        Screenshot("uav_sky"),
        Log("scan"),
        Commander(Use(asset: Scan, target: (0.0, 0.0, 0.0))),
        Wait(1.5),
        HoldKey(KeyM),
        Wait(0.5),
        Screenshot("scan_map"),
        ReleaseKey(KeyM),
        Log("supply"),
        Look(180.0, 0.0),
        Hurt(60.0),
        Vitals("hurt"),
        Commander(Use(asset: Supply, target: (-150.0, 0.0, 266.0))),
        Wait(5.0),
        Look(180.0, 25.0),
        Screenshot("supply_falling"),
        Wait(7.0),
        Look(180.0, -10.0),
        Screenshot("supply_landed"),
        Teleport((-150.0, 162.0, 264.0), 180.0, -10.0),
        Wait(6.0),
        Vitals("after supply"),
        Key(CapsLock),
        Wait(0.8),
        Screenshot("screen_recharge"),
        Key(CapsLock),
        Log("resign"),
        Commander(Resign),
        Wait(1.5),
        Quit,
    ],
)
