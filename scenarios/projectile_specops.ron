// Special Forces kit on Strike at Karkand: hand grenades (a quick throw with its full 2.8 s
// fuse, a cooked one that goes off soon after landing, one held too long that goes off in
// the hand), then C4: two charges thrown, the detonator taken out with the alternative fire
// button (zoom), both set off from a distance. See the `game_server::combat` log lines.
// client --scenario scenarios/projectile_specops.ron --out target/scenarios/projectile/specops
(
    level: "strike_at_karkand",
    bots: 0,
    steps: [
        WaitReady,
        Kill,
        Wait(1.0),
        Click("kit:0"),
        Wait(16.0),
        Teleport((-184.0, 157.0, -85.0), 180.0, -8.0),
        Weapon(1),
        Wait(1.2),
        // Quick throw: wound up for 0.2 s (less than the 0.45 s pull back).
        Hold([Fire]),
        Wait(0.2),
        Release([Fire]),
        Wait(0.6),
        Screenshot("frag_flight"),
        Wait(2.4),
        Screenshot("frag_before"),
        Wait(0.25),
        Screenshot("frag_boom_1"),
        Wait(0.2),
        Screenshot("frag_boom_2"),
        Wait(1.0),
        // Cooked for 1.5 s: goes off 1.25 s after leaving the hand.
        Hold([Fire]),
        Wait(2.0),
        Screenshot("frag_cooking"),
        Release([Fire]),
        Wait(1.5),
        Screenshot("frag_cooked_boom"),
        Wait(1.5),
        // Held too long.
        Hold([Fire]),
        Wait(3.6),
        Screenshot("frag_in_hand"),
        Release([Fire]),
        Wait(1.0),
        Click("kit:0"),
        Wait(16.0),
        // C4: two charges on the ground ahead, then the detonator from 15 m back.
        Teleport((-184.0, 157.0, -85.0), 180.0, -35.0),
        Weapon(3),
        Wait(1.5),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(1.0),
        Look(160.0, -35.0),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(1.0),
        Look(170.0, -20.0),
        Screenshot("c4_placed"),
        Teleport((-184.0, 157.0, -100.0), 180.0, -8.0),
        Wait(1.0),
        Hold([Aim]),
        Wait(0.1),
        Release([Aim]),
        Wait(0.3),
        Screenshot("c4_detonator"),
        Hold([Fire]),
        Wait(0.1),
        Release([Fire]),
        Wait(0.1),
        Screenshot("c4_boom_1"),
        Wait(0.3),
        Screenshot("c4_boom_2"),
        Wait(1.0),
        Quit,
    ],
)
