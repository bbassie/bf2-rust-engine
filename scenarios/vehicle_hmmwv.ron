// Getting into the HMMWV at the US main base (Gas Station), driving out onto the road and
// north, turning, braking, the gunner's seat and getting out. The report logs the vehicle's
// speed and position along the way.
// client --scenario scenarios/vehicle_hmmwv.ron --out target/scenarios/vehicle/hmmwv
(
    level: "strike_at_karkand",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("usjep_hmmwv"),
        ThirdPerson(true),
        Wait(1.5),
        Screenshot("outside"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(0.5),
        VehicleInfo("entered"),
        ThirdPerson(false),
        VehicleLook(0.0, -5.0),
        Wait(0.3),
        Screenshot("driver_view"),
        ThirdPerson(true),
        VehicleLook(0.0, -10.0),
        Wait(0.3),
        Screenshot("chase"),
        // Out of the gas station onto the road, then right (north).
        Move(0.0, 1.0),
        Wait(1.5),
        VehicleInfo("throttle 1.5 s"),
        Move(1.0, 0.6),
        Wait(1.6),
        VehicleInfo("turned right"),
        Move(0.0, 1.0),
        Wait(2.0),
        VehicleInfo("straight 2 s"),
        Screenshot("driving"),
        Wait(2.0),
        VehicleInfo("straight 4 s"),
        Move(-0.6, 1.0),
        Wait(1.0),
        VehicleInfo("turning left 1 s"),
        Screenshot("turning"),
        Move(0.0, -1.0),
        Wait(1.5),
        VehicleInfo("braking 1.5 s"),
        Move(0.0, 0.0),
        Wait(2.0),
        VehicleInfo("released 2 s"),
        Seat(2),
        Wait(0.5),
        VehicleInfo("gunner seat"),
        VehicleLook(90.0, 5.0),
        Wait(1.5),
        Screenshot("gunner"),
        ThirdPerson(false),
        Wait(0.3),
        Screenshot("gunner_view"),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        VehicleInfo("got out"),
        ThirdPerson(true),
        Wait(0.3),
        Screenshot("exited"),
        Quit,
    ],
)
