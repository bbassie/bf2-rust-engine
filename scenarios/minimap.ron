(
    level: "strike_at_karkand",
    bots: 8,
    steps: [
        WaitReady,
        Teleport((-184.0, 157.0, -85.0), 0.0, -4.0),
        Wait(1.5),
        Screenshot("rotating_north"),
        Look(-90.0, -4.0),
        Wait(0.3),
        Screenshot("rotating_east"),
        Key(KeyN),
        Wait(0.3),
        Screenshot("north_up_east"),
        Quit,
    ],
)
