// Audio under fire, checked through the log: we stand in the US bots' way from the Gas
// Station to the Hotel, so they shoot at us. Look for `flyby`, `impact`, `hurt`, `death` and
// `body fall` lines, and for the voice counts staying within the limit.
// RUST_LOG=info,audio=debug target/debug/deps/client.exe --scenario scenarios/audio_combat.ron --out target/scenarios/audio/combat
(
    level: "strike_at_karkand",
    bots: 16,
    team: 1,
    steps: [
        WaitReady,
        Teleport((-165.0, 185.0, 215.0), 0.0, 0.0),
        Log("under fire"),
        Wait(40.0),
        Screenshot("end"),
        Quit,
    ],
)
