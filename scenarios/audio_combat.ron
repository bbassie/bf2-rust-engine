// Audio under fire, checked through the log: we join the US team and stand at the MEC-held
// Hotel, so its defenders shoot at us. Look for `flyby`, `impact`, `hurt`, `death` and
// `body fall` lines, and for the voice counts staying within the limit.
// RUST_LOG=info,audio=debug target/debug/deps/client.exe --scenario scenarios/audio_combat.ron --out target/scenarios/audio/combat
(
    level: "strike_at_karkand",
    bots: 16,
    team: 2,
    steps: [
        WaitReady,
        Teleport((-190.0, 158.5, 5.0), 180.0, 0.0),
        Log("under fire"),
        Wait(30.0),
        Screenshot("end"),
        Quit,
    ],
)
