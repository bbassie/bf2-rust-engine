// The F-35B's vertical take-off from the US ship on Gulf of Oman: holding S swings it into
// hover, W lifts it off the deck, hands off it holds its altitude, the stick tilts it forwards
// to drift, then the afterburner takes it into jet flight. Traces go to the report.
// client --scenario scenarios/vehicle2_f35b_hover.ron --out target/scenarios/vehicle2/f35b_hover
(
    level: "gulf_of_oman",
    size: 64,
    team: 2,
    bots: 0,
    steps: [
        WaitReady,
        Wait(2.0),
        NearVehicle("air_f35b"),
        Wait(0.5),
        Hold([Use]),
        Wait(0.2),
        Release([Use]),
        Wait(1.0),
        ThirdPerson(true),
        VehicleInfo("parked"),
        Screenshot("01_parked"),
        Move(0.0, -1.0),
        VehicleTrace("hover on", 1.5),
        Move(0.0, 1.0),
        VehicleTrace("lift off", 5.0),
        Screenshot("02_lifting"),
        Move(0.0, 0.0),
        VehicleTrace("hold", 4.0),
        Screenshot("03_hovering"),
        Stick(0.0, -0.4),
        VehicleTrace("tilt forwards", 2.0),
        Stick(0.0, 0.0),
        VehicleTrace("drift", 3.0),
        Screenshot("04_drifting"),
        Hold([Sprint]),
        Move(0.0, 1.0),
        VehicleTrace("to jet flight", 8.0),
        Release([Sprint]),
        Screenshot("05_flying"),
        Move(0.0, 0.0),
        VehicleTrace("cruise", 3.0),
        Quit,
    ],
)
